---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | RetainOS"
  description="Get in touch with the RetainOS team. We'd love to hear from you."
  breadcrumbs={[
    { name: 'Home', url: 'https://retaindental.com/' },
    { name: 'Contact', url: 'https://retaindental.com/contact' },
  ]}
>
  <section class="pt-36 pb-24 px-6 bg-paper-50">
    <div class="max-w-4xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h1 class="text-5xl md:text-6xl font-sans font-[400] text-text-900 tracking-tight mb-6">Let's <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-violet-400">talk</span>.</h1>
        <p class="text-lg sm:text-xl text-text-600 leading-relaxed">Whether you're ready to pilot, evaluating alternatives, or just curious — we'd love to hear from you.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-10 mb-16">
        <div class="space-y-8">
          <div class="p-6 rounded bg-white border border-paper-line flex items-start gap-4">
            <div class="w-10 h-10 rounded bg-violet-600/10 flex items-center justify-center shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7C5CFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-text-900 mb-1">Email</h3>
              <a href="mailto:hello@retaindental.com" class="text-violet-600 font-medium hover:underline">hello@retaindental.com</a>
              <p class="text-sm text-text-600 mt-1">We respond within 24 hours</p>
            </div>
          </div>
          <div class="p-6 rounded bg-white border border-paper-line flex items-start gap-4">
            <div class="w-10 h-10 rounded bg-violet-600/10 flex items-center justify-center shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7C5CFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-text-900 mb-1">Office</h3>
              <p class="text-text-600">Austin, Texas</p>
              <p class="text-sm text-text-600 mt-1">Remote-first team</p>
            </div>
          </div>
          <div class="p-6 rounded bg-white border border-paper-line flex items-start gap-4">
            <div class="w-10 h-10 rounded bg-violet-600/10 flex items-center justify-center shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7C5CFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-text-900 mb-1">Phone</h3>
              <p class="text-text-600">+1 (512) 666-1640</p>
              <p class="text-sm text-text-600 mt-1">Mon–Fri, 9am–6pm CT</p>
            </div>
          </div>
        </div>

        <div class="p-8 rounded bg-white border border-paper-line">
          <h2 class="text-xl font-bold text-text-900 mb-6">Send us a message</h2>
          <form action="https://formspree.io/f/xjkyryra" method="POST" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-semibold text-text-600 mb-1.5">Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded border border-paper-line bg-paper-50 text-text-900 placeholder-text-600 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all" placeholder="Your name" />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-text-600 mb-1.5">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded border border-paper-line bg-paper-50 text-text-900 placeholder-text-600 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all" placeholder="you@practice.com" />
              </div>
            </div>
            <div>
              <label for="clinic" class="block text-sm font-semibold text-text-600 mb-1.5">Clinic or DSO</label>
              <input type="text" id="clinic" name="clinic" class="w-full px-4 py-3 rounded border border-paper-line bg-paper-50 text-text-900 placeholder-text-600 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all" placeholder="Your clinic / DSO name" />
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-text-600 mb-1.5">Message</label>
              <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 rounded border border-paper-line bg-paper-50 text-text-900 placeholder-text-600 focus:outline-none focus:ring-2 focus:ring-violet-600 focus:border-transparent transition-all resize-none" placeholder="Tell us about your practice..."></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-violet-600 text-white rounded font-bold text-lg hover:bg-violet-500 transition-all shadow-lg shadow-violet-600/20">Send message</button>
          </form>
        </div>
      </div>

      <div class="p-8 rounded bg-gradient-to-br from-ink-900 to-ink-800 text-white text-center">
        <h2 class="text-xl font-bold mb-3">Ready to launch your app?</h2>
        <p class="text-text-onDark-500 mb-6">Start free — no credit card, no commitment.</p>
        <a href="https://app.retaindental.com" class="inline-flex items-center gap-2 px-8 py-3 bg-white/10 backdrop-blur text-text-onDark-500 rounded font-bold hover:bg-white/20 transition-all">Build My App <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>
</Layout>
