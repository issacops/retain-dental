---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | RetainOS">
  <section class="min-h-screen flex items-center justify-center px-6 bg-cream-50">
    <div class="text-center space-y-8 max-w-lg">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-teal-50 border border-teal-200">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h1 class="text-7xl md:text-8xl font-black text-slate-900 tracking-tighter">404</h1>
      <p class="text-xl text-slate-500 leading-relaxed">This page does not exist. If you believe this is an error, <a href="/contact" class="text-teal-600 font-semibold hover:underline">let us know</a>.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="/" class="px-8 py-3 bg-teal-600 text-white rounded-full font-bold hover:bg-teal-700 transition-all">Go home</a>
        <a href="/blog" class="px-8 py-3 bg-white border border-gray-200 text-slate-700 rounded-full font-bold hover:bg-cream-100 transition-all">Read our blog</a>
      </div>
    </div>
  </section>
</Layout>
