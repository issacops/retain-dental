const featuredPosts = posts.filter(p => p.featured);
const regularPosts = posts.filter(p => !p.featured);
const allTags = [...new Set(posts.flatMap(p => p.tags))].sort();
const sortedPosts = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
---

<Layout
  title="RetainOS Blog — Dental Practice Growth & Patient Retention Insights"
  description="Expert advice on dental patient retention, Invisalign compliance tracking, launching loyalty apps, and growing your dental practice with technology. Written by practicing dentists."
  canonical="https://retaindental.com/blog"
>
  <Navbar />
  <section class="pt-32 pb-24 px-6 bg-cream-50 min-h-screen">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 space-y-4">
        <span class="text-teal-600 font-black tracking-widest uppercase text-sm">The RetainOS Blog</span>
        <h1 class="text-5xl md:text-7xl font-black text-slate-900 tracking-tighter leading-[1.05]">
          Dental Practice <span class="text-teal-600">Growth Insights</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">
          Expert guides, benchmarks, and strategies written by practising dentists. No fluff. No theory. Just what actually works in real clinics.
        </p>
      </div>

      <div class="hidden sm:flex flex-wrap gap-2 justify-center mb-14">
        {allTags.map(tag => (
          <span class="text-xs font-bold text-slate-500 bg-white border border-gray-200 px-3 py-1.5 rounded-full hover:border-teal-300 hover:text-teal-600 transition-colors cursor-pointer">{tag}</span>
        ))}
      </div>

      <div class="space-y-10">
        {sortedPosts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class="block group">
            <article class={`rounded-3xl border transition-all duration-300 hover:shadow-xl ${
              i < 2
                ? 'p-8 md:p-10 bg-gradient-to-br from-teal-900 via-teal-800 to-teal-950 text-white border-teal-700 hover:border-teal-400/50 hover:shadow-teal-500/10'
                : i % 2 === 0
                  ? 'p-8 bg-white border-gray-200 hover:border-teal-300 hover:shadow-teal-500/5'
                  : 'p-8 bg-cream-100/80 border-gray-200 hover:border-teal-300 hover:shadow-teal-500/5'
            }`}>
              <div class="flex flex-wrap gap-2 mb-4">
                {post.tags.map(tag => (
                  <span class={`text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-widest ${
                    i < 2
                      ? 'text-teal-200 bg-white/10'
                      : 'text-teal-600 bg-teal-50'
                  }`}>{tag}</span>
                ))}
              </div>
              <h2 class={`text-2xl md:text-3xl font-black tracking-tight mb-3 transition-colors ${
                i < 2 ? 'text-white group-hover:text-teal-200' : 'text-slate-900 group-hover:text-teal-600'
              }`}>
                {post.title}
              </h2>
              <p class={`leading-relaxed mb-4 max-w-2xl ${
                i < 2 ? 'text-teal-100/80' : 'text-slate-500'
              }`}>{post.excerpt}</p>
              <div class="flex items-center gap-3 text-sm">
                <div class={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-black ${
                  i < 2 ? 'bg-white/20 text-white' : 'bg-teal-100 text-teal-600'
                }`}>
                  {post.author.split(' ').map(w => w[0]).join('').slice(0, 2)}
                </div>
                <span class={i < 2 ? 'text-teal-100' : 'text-slate-500'}>{post.author}</span>
                <span class={i < 2 ? 'text-teal-100/60' : 'text-slate-400'}>·</span>
                <span class={i < 2 ? 'text-teal-100/60' : 'text-slate-400'}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
            </article>
          </a>
        ))}
      </div>

      <div class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-teal-900 via-teal-800 to-teal-950 text-white text-center">
        <p class="text-2xl font-black mb-3">Write for the RetainOS Blog</p>
        <p class="text-teal-200 text-sm mb-6 max-w-lg mx-auto">We publish guest posts from practising dentists. Share your clinical and operational expertise with 5,000+ dental professionals.</p>
        <a href="https://app.retaindental.com" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-teal-900 rounded-full text-sm font-black hover:bg-teal-50 hover:scale-105 transition-all">Get in touch →</a>
      </div>
    </div>
  </section>
  <Footer />
  <StickyMobileCta />
</Layout>
