---
import Layout from '../../layouts/Layout.astro'
import { sortedPosts, featuredPosts, allTags } from '../../data/posts'
import CTA from '../../components/CTA.astro'

const featured = featuredPosts.slice(0, 3)
const featuredSlugs = new Set(featured.map((p) => p.slug))
const rest = sortedPosts.filter((p) => !featuredSlugs.has(p.slug))
---
<Layout
  title="Blog | Dental Patient Retention, Aftercare and Referral Guides"
  description="Practical guides on dental patient retention, aftercare, recall, loyalty, and referrals. Written for practice owners who want patients to come back and bring friends."
  canonical="/blog"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }]}
>
  <section class="relative overflow-hidden bg-cream-100 pt-32 pb-16 sm:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 right-1/4 h-[28rem] w-[28rem] rounded-full bg-teal-200/40 blur-[120px]"></div>
    </div>
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="eyebrow text-teal-700">The Retain Dental blog</p>
      <h1 class="mt-4 font-heading text-[clamp(2.2rem,5vw,3.5rem)] font-semibold leading-[1.06] tracking-tight text-ink-900 text-balance">
        Dental growth, without the fluff.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-600">
        Practical guides on retention, aftercare, recall, loyalty, and referrals, written for practice owners who want patients to come back and bring friends.
      </p>
    </div>
  </section>

  <section class="bg-cream-100 pb-20 sm:pb-28">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <!-- Featured -->
      <div class="grid gap-6 lg:grid-cols-3">
        {featured.map((p) => (
          <a href={`/blog/${p.slug}`} class="card card-lift flex flex-col p-7">
            <span class="eyebrow text-teal-700">{p.tags.join(' | ')}</span>
            <h2 class="mt-3 font-heading text-xl font-semibold leading-snug tracking-tight text-ink-900">{p.title}</h2>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink-600">{p.excerpt}</p>
            <span class="mt-5 text-[13px] text-ink-500">{p.author} | {new Date(p.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
          </a>
        ))}
      </div>

      <!-- Search + filters -->
      <div class="mt-16 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="relative w-full lg:max-w-sm">
          <svg class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="blog-search" type="text" placeholder="Search articles" aria-label="Search articles"
            class="w-full rounded-full border border-cream-300 bg-white py-3 pl-11 pr-5 text-sm text-ink-900 outline-none transition-colors placeholder:text-ink-400 focus:border-teal-500" />
        </div>
        <div class="flex flex-wrap gap-2" id="tag-filters">
          <button class="tag-btn rounded-full border border-teal-600 bg-teal-600 px-3.5 py-1.5 text-xs font-semibold text-white" data-tag="all">All</button>
          {allTags.map((t) => (
            <button class="tag-btn rounded-full border border-cream-300 bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-600 transition-colors hover:border-teal-300" data-tag={t}>{t}</button>
          ))}
        </div>
      </div>

      <!-- Grid -->
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="post-grid">
        {rest.map((p) => (
          <a href={`/blog/${p.slug}`} class="post-card card card-lift flex flex-col p-7" data-tags={p.tags.join(',')} data-title={p.title.toLowerCase()} data-excerpt={p.excerpt.toLowerCase()}>
            <span class="eyebrow text-teal-700">{p.tags[0]}</span>
            <h2 class="mt-3 font-heading text-lg font-semibold leading-snug tracking-tight text-ink-900">{p.title}</h2>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink-600">{p.excerpt}</p>
            <span class="mt-5 text-[13px] text-ink-500">{p.author} | {new Date(p.date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
          </a>
        ))}
      </div>

      <p id="no-results" class="hidden py-20 text-center text-ink-500">No articles match your search.</p>
    </div>
  </section>

  <CTA />

  <script>
    const searchInput = document.getElementById('blog-search') as HTMLInputElement | null
    const tagButtons = document.querySelectorAll('.tag-btn')
    const postCards = document.querySelectorAll('.post-card')
    const noResults = document.getElementById('no-results')
    let activeTag = 'all'

    function filterPosts() {
      const query = searchInput?.value.toLowerCase() || ''
      let visible = 0
      postCards.forEach((card) => {
        const el = card as HTMLElement
        const title = el.getAttribute('data-title') || ''
        const excerpt = el.getAttribute('data-excerpt') || ''
        const tags = (el.getAttribute('data-tags') || '').split(',')
        const matches = (!query || title.includes(query) || excerpt.includes(query)) && (activeTag === 'all' || tags.includes(activeTag))
        el.style.display = matches ? '' : 'none'
        if (matches) visible++
      })
      noResults?.classList.toggle('hidden', visible > 0)
    }

    searchInput?.addEventListener('input', filterPosts)
    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.getAttribute('data-tag') || 'all'
        tagButtons.forEach((b) => {
          b.classList.remove('bg-teal-600', 'text-white', 'border-teal-600')
          b.classList.add('bg-white', 'text-ink-600', 'border-cream-300')
        })
        btn.classList.add('bg-teal-600', 'text-white', 'border-teal-600')
        btn.classList.remove('bg-white', 'text-ink-600', 'border-cream-300')
        filterPosts()
      })
    })
  </script>
</Layout>
