---
import Layout from '../layouts/Layout.astro'
import CTA from '../components/CTA.astro'
import { competitors } from '../data/competitors'

export function getStaticPaths() {
  return competitors.map((c) => ({ params: { competitor: c.slug }, props: { competitor: c } }))
}

const { competitor } = Astro.props
const { name, tagline, intro, theirStrength, ourAngle, rows, faqs } = competitor
---
<Layout
  title={`Retain Dental vs ${name} | Dental Patient Retention Compared`}
  description={`How Retain Dental compares to ${name} for dental patient retention. ${tagline}. See the feature comparison and where each product fits.`}
  canonical={`/vs-${competitor.slug}`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: `vs ${name}`, url: `/vs-${competitor.slug}` }]}
  faqs={faqs}
>
  <section class="relative overflow-hidden bg-cream-100 pt-32 pb-16 sm:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 left-1/4 h-[28rem] w-[28rem] rounded-full bg-teal-200/40 blur-[120px]"></div>
    </div>
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="eyebrow text-teal-700">Comparison</p>
      <h1 class="mt-4 font-heading text-[clamp(2rem,4.6vw,3.2rem)] font-semibold leading-[1.07] tracking-tight text-ink-900 text-balance">
        Retain Dental vs {name}
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-600">{intro}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/start" data-cta={`vs-${competitor.slug}-start`} class="btn-primary min-h-[52px]">Start free trial</a>
        <a href="/contact" data-cta={`vs-${competitor.slug}-demo`} class="btn-ghost min-h-[52px]">Book a demo</a>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 pb-16">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="card p-7">
          <p class="eyebrow text-ink-500">Where {name} wins</p>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{theirStrength}</p>
        </div>
        <div class="card p-7">
          <p class="eyebrow text-teal-700">Where Retain Dental wins</p>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{ourAngle}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-50 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <h2 class="font-heading text-[clamp(1.7rem,3.2vw,2.4rem)] font-semibold tracking-tight text-ink-900">
        Feature comparison
      </h2>
      <div class="mt-8 overflow-hidden rounded-3xl border border-cream-300 bg-cream-50">
        <div class="grid grid-cols-3 gap-4 border-b border-cream-200 px-6 py-4 sm:px-8">
          <span class="eyebrow text-ink-400">Capability</span>
          <span class="eyebrow text-teal-700">Retain Dental</span>
          <span class="eyebrow text-ink-400">{name}</span>
        </div>
        {rows.map((r) => (
          <div class="grid grid-cols-3 gap-4 border-b border-cream-200 px-6 py-4 last:border-b-0 sm:px-8">
            <span class="text-[15px] font-semibold text-ink-900">{r.feature}</span>
            <span class="text-[15px] text-ink-700">{typeof r.retain === 'boolean' ? (r.retain ? 'Yes' : 'No') : r.retain}</span>
            <span class="text-[15px] text-ink-500">{typeof r.them === 'boolean' ? (r.them ? 'Yes' : 'No') : r.them}</span>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-ink-400">
        Comparison reflects publicly available product information and may change. Verify current details with {name} directly.
      </p>
    </div>
  </section>

  <section class="bg-cream-100 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-heading text-2xl font-semibold tracking-tight text-ink-900">Questions worth asking</h2>
      <div class="mt-6 divide-y divide-cream-200 overflow-hidden rounded-2xl border border-cream-300 bg-cream-50">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-5">
              <span class="font-semibold text-ink-900">{f.question}</span>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cream-300 text-ink-600 transition-transform group-open:rotate-45">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="-mt-1 px-5 pb-6 text-[15px] leading-relaxed text-ink-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
