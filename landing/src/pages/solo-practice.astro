---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCta from '../components/StickyMobileCta.astro';

const features = [
  { icon: 'phone', title: 'Your brand in their pocket', desc: 'Custom logo, color, and domain. Patients download YOUR app, not "yet another portal".' },
  { icon: 'calendar', title: 'Fill empty chairs', desc: 'Automated re-care + recall + birthday campaigns. No-shows drop. Schedules fill.' },
  { icon: 'wallet', title: 'Get paid faster', desc: 'In-app invoice pay via Stripe. Patients settle balances in two taps. No more chasing checks.' },
  { icon: 'trophy', title: 'Loyalty on autopilot', desc: 'Silver / Gold / Platinum tiers. Patients earn on visits, redeem on whitening, cleanings, and more.' },
  { icon: 'sparkles', title: 'Social posts in 30 seconds', desc: 'Pick a template, add a photo, post to Instagram. No designer needed.' },
  { icon: 'check', title: 'Up and running in 20 minutes', desc: 'No IT team. No code. We sync with your existing PMS in under an hour.' },
];
---

<Layout
  title="RetainOS for Solo Practices — Affordable Dental Patient App"
  description="RetainOS Starter is the affordable patient engagement platform for solo dental practices. Launch your branded app in 20 minutes. Automated recall, loyalty tiers, and in-app payments from ₹4,999/mo."
  keywords={['solo dental practice software', 'dental software for small practice', 'affordable dental CRM', 'dental patient app for solo practice', 'dental recall software for solo dentist']}
  canonical="https://retaindental.com/solo-practice"
  breadcrumbs={[
    { name: 'Home', url: 'https://retaindental.com/' },
    { name: 'For Solo Practices', url: 'https://retaindental.com/solo-practice' },
  ]}
>
  <Navbar />

  <section class="pt-32 pb-16 px-6 bg-gradient-to-b from-cream-100 to-cream-50">
    <div class="max-w-5xl mx-auto text-center space-y-6">
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-teal-50 border border-teal-200 rounded-full text-xs font-bold text-teal-700 uppercase tracking-widest">
        For Solo Practices
      </span>
      <h1 class="text-5xl md:text-7xl font-black text-slate-900 tracking-tighter leading-[1.05]">
        Run your practice <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-amber-600">like a brand.</span>
      </h1>
      <p class="text-xl text-slate-500 max-w-2xl mx-auto leading-relaxed">
        You don't need a marketing team or a 20-location DSO to compete.
        You need a brand patients actually open on their phone.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4">
        <a href="https://app.retaindental.com" class="px-8 py-4 bg-teal-600 text-white rounded-full font-bold hover:bg-teal-700 transition-all shadow-lg shadow-teal-600/20 flex items-center justify-center gap-2">
          Start 14-day free trial →
        </a>
        <a href="/pricing" class="px-8 py-4 bg-white text-slate-700 border border-gray-200 rounded-full font-bold hover:bg-cream-100 transition-all flex items-center justify-center">
          See pricing
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-cream-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 space-y-4">
        <h2 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tighter">
          Everything a solo practice needs. <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-amber-600">Nothing it doesn't.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {features.map((f) => (
          <div class="bg-white rounded-3xl p-6 border border-gray-200 hover:shadow-lg transition-all">
            <div class="h-10 w-10 bg-teal-50 text-teal-600 rounded-xl flex items-center justify-center mb-4">
              {f.icon === 'phone' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>}
              {f.icon === 'calendar' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>}
              {f.icon === 'wallet' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"/></svg>}
              {f.icon === 'trophy' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>}
              {f.icon === 'sparkles' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>}
              {f.icon === 'check' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
            </div>
            <h3 class="text-lg font-black text-slate-900 mb-2">{f.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-6 bg-cream-100">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm">
        <p class="text-[10px] font-black text-teal-600 uppercase tracking-widest mb-3">A 14-day trial. No credit card.</p>
        <h3 class="text-3xl font-black text-slate-900 mb-2">Try it on your real patients.</h3>
        <p class="text-slate-500 mb-6">If you don't see a measurable retention lift in 30 days, we'll help you offboard.</p>
        <a href="https://app.retaindental.com" class="inline-block px-8 py-4 bg-teal-600 text-white rounded-full font-bold hover:bg-teal-700 transition-all">
          Get started free →
        </a>
      </div>
    </div>
  </section>

  <Footer />
  <StickyMobileCta />
</Layout>
