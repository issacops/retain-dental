---
import Layout from '../layouts/Layout.astro'
import FAQSection from '../components/FAQSection.astro'
import CTA from '../components/CTA.astro'

const plans = [
  {
    name: 'Starter',
    tagline: 'For single-location practices getting retention under control.',
    highlight: false,
    best: 'Best for: solo practices and one-chair studios',
    features: [
      'Your own branded patient app',
      'Automated recall and reactivation',
      'Aftercare checklists and adherence tracking',
      'Loyalty points and membership tiers',
      'Patient records and booking',
      'Email support',
    ],
  },
  {
    name: 'Growth',
    tagline: 'For growing practices that want the full retention and referral loop.',
    highlight: true,
    best: 'Best for: multi-doctor practices and small groups',
    features: [
      'Everything in Starter',
      'Household points pooling for families',
      'Referral rewards for patients',
      'Review collection after visits',
      'In-app payments and balances',
      'Branded social content studio',
      'PMS integration (Dentrix, Eaglesoft, Open Dental)',
      'Priority support',
    ],
  },
  {
    name: 'Enterprise',
    tagline: 'For DSOs and multi-location groups that need it across every practice.',
    highlight: false,
    best: 'Best for: DSOs and 3+ location groups',
    features: [
      'Everything in Growth',
      'Network dashboard across locations',
      'Unlimited locations and patients',
      'Custom PMS and EHR integration',
      'SSO and role-based access controls',
      'BAA and HIPAA documentation',
      'Dedicated success manager',
      'Uptime SLA',
    ],
  },
]

const faqs = [
  {
    question: 'How does pricing work?',
    answer:
      'Pricing is per location and scales with the number of active patients you actually have, not a guess from a sales rep. There are no setup fees and no per-feature upcharges. Book a demo and we will show you exactly what it looks like for your practice.',
  },
  {
    question: 'Can I switch plans later?',
    answer:
      'Yes. You can move between plans at any time as your practice grows. Upgrades take effect immediately and downgrades at the end of your billing period.',
  },
  {
    question: 'Is there a setup fee?',
    answer:
      'No. Setup, branding, and your first patient imports are included. Most practices are live in about 20 minutes.',
  },
  {
    question: 'How is an active patient counted?',
    answer:
      'An active patient is anyone who has visited or engaged with your practice in the last 18 months. You are never charged for patients who have already left.',
  },
  {
    question: 'Do you offer a free trial?',
    answer:
      'Yes. Every plan starts with a 14-day free trial, no credit card required. You can run it on your real patients and see your retention change before you pay anything.',
  },
  {
    question: 'Do you handle payments in the app?',
    answer:
      'Yes, on the Growth and Enterprise plans. Patients can pay balances and treatment costs in-app, which reduces outstanding balances and saves your front desk time.',
  },
]

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Retain Dental',
  description:
    'Patient retention platform for dental practices. A branded patient app for aftercare, recalls, loyalty, and referrals.',
  brand: { '@type': 'Brand', name: 'Retain Dental' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    offerCount: 3,
    url: 'https://www.retaindental.com/pricing',
  },
}
---
<Layout
  title="Plans | Retain Dental for Solo Practices, Groups and DSOs"
  description="Simple per-location plans for dental practices of every size. Start free for 14 days, no credit card. Your branded app for aftercare, retention and referrals."
  canonical="/pricing"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Plans', url: '/pricing' }]}
  faqs={faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="relative overflow-hidden bg-cream-100 pt-32 pb-20 sm:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-24 left-1/4 h-[30rem] w-[30rem] rounded-full bg-teal-200/40 blur-[120px]"></div>
    </div>
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
      <p class="eyebrow text-teal-700">Plans</p>
      <h1 class="mt-4 font-heading text-[clamp(2.2rem,5vw,3.6rem)] font-semibold leading-[1.05] tracking-tight text-ink-900 text-balance">
        Plans that grow with your practice.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-600">
        No setup fees. No per-feature upcharges. Pay for the size of practice you actually have, and move up only when you need to.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/start" data-cta="plans-start" class="btn-primary min-h-[52px]">Start free trial</a>
        <a href="/contact" data-cta="plans-demo" class="btn-ghost min-h-[52px]">Book a demo</a>
      </div>
      <p class="mt-4 text-[13px] text-ink-500">14 days free | No credit card | Cancel anytime</p>
    </div>
  </section>

  <section class="bg-cream-100 pb-20 sm:pb-28">
    <div class="mx-auto max-w-8xl px-5 sm:px-8">
      <div class="grid gap-6 lg:grid-cols-3">
        {plans.map((p) => (
          <div class:list={['card card-lift flex flex-col p-8', p.highlight && 'ring-gradient bg-white']}>
            {p.highlight && (
              <span class="mb-4 inline-flex w-fit items-center rounded-full bg-teal-600 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white">Most popular</span>
            )}
            <h2 class="font-heading text-2xl font-semibold tracking-tight text-ink-900">{p.name}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{p.tagline}</p>
            <p class="mt-4 text-[13px] font-semibold text-teal-800">{p.best}</p>
            <div class="hairline my-6"></div>
            <ul class="flex-1 space-y-3">
              {p.features.map((f) => (
                <li class="flex items-start gap-3 text-[15px] text-ink-700">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal-100 text-teal-700">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={p.name === 'Enterprise' ? '/contact' : '/start'}
              data-cta={`plan-${p.name.toLowerCase()}`}
              class:list={['mt-8 min-h-[48px]', p.highlight ? 'btn-primary' : 'btn-ghost']}
            >
              {p.name === 'Enterprise' ? 'Talk to us' : 'Start free trial'}
            </a>
          </div>
        ))}
      </div>

      <p class="mt-8 text-center text-sm text-ink-500">
        Running more than one location? <a href="/dso" class="font-semibold text-teal-700 underline decoration-teal-300 underline-offset-4 hover:text-teal-800">See the DSO overview</a>.
      </p>
    </div>
  </section>

  <FAQSection faqs={faqs} />
  <CTA />
</Layout>
