---
import Layout from './Layout.astro'
import { sortedPosts } from '../data/posts'

export interface FAQ { question: string; answer: string }
export interface Props {
  title: string
  description: string
  canonical: string
  slug: string
  author?: string
  date?: string
  modifiedDate?: string
  readTime?: string
  tags?: string[]
  quickAnswer?: string
  takeaways?: string[]
  faqs?: FAQ[]
}

const {
  title,
  description,
  canonical,
  slug,
  author = 'Retain Dental Team',
  date,
  modifiedDate,
  readTime = '6 min read',
  tags = [],
  quickAnswer,
  takeaways = [],
  faqs = [],
} = Astro.props

const cleanTitle = title.replace(/\s*[,|]\s*Retain Dental\s*$/i, '').trim()
const seoTitle = /Retain Dental\s*$/i.test(title) ? title.replace(/\s*,\s*Retain Dental\s*$/i, ' | Retain Dental') : title
const related = sortedPosts.filter((p) => p.slug !== slug).slice(0, 3)

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: modifiedDate || date,
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Retain Dental',
    logo: { '@type': 'ImageObject', url: 'https://www.retaindental.com/brand/lockup-teal.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  about: tags.map((t) => ({ '@type': 'Thing', name: t })),
}
---
<Layout
  title={seoTitle}
  description={description}
  pageType="article"
  articlePublishedTime={date}
  canonical={canonical}
  faqs={faqs.length ? faqs : undefined}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: title, url: canonical },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <article class="bg-cream-100 pb-24 pt-28 sm:pt-32">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <nav class="text-[13px] text-ink-500" aria-label="Breadcrumb">
        <a href="/blog" class="font-medium text-teal-700 hover:text-teal-800">Blog</a>
        <span class="px-2 text-ink-300">/</span>
        <span>{tags[0] || 'Guide'}</span>
      </nav>

      <header class="mt-6">
        <div class="flex flex-wrap items-center gap-2">
          {tags.map((t) => (
            <span class="rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-teal-800">{t}</span>
          ))}
        </div>
        <h1 class="mt-5 font-heading text-[clamp(2rem,4.4vw,3.1rem)] font-semibold leading-[1.08] tracking-tight text-ink-900 text-balance">{cleanTitle}</h1>
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-ink-500">
          <span class="font-semibold text-ink-700">{author}</span>
          {date && <><span class="text-ink-300">|</span><time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></>}
          <span class="text-ink-300">|</span>
          <span>{readTime}</span>
        </div>
      </header>

      {quickAnswer && (
        <aside class="card mt-9 p-6 sm:p-7" aria-label="Quick answer">
          <p class="eyebrow text-teal-700">Quick answer</p>
          <p class="mt-3 text-[17px] leading-relaxed text-ink-700">{quickAnswer}</p>
        </aside>
      )}

      {takeaways.length > 0 && (
        <aside class="card-white mt-6 p-6 sm:p-7" aria-label="Key takeaways">
          <p class="eyebrow text-ink-500">Key takeaways</p>
          <ul class="mt-4 space-y-3">
            {takeaways.map((t) => (
              <li class="flex items-start gap-3 text-[15px] leading-relaxed text-ink-700">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                {t}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <div class="mt-10 space-y-6 text-[17px] leading-relaxed text-ink-700 [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-ink-900 [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-heading [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-ink-900 [&_p]:text-ink-700 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_strong]:text-ink-900 [&_a]:text-teal-700 [&_a]:underline [&_a]:decoration-teal-300 [&_a]:underline-offset-4 [&_blockquote]:border-l-2 [&_blockquote]:border-teal-300 [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-ink-600">
        <slot />
      </div>

      {faqs.length > 0 && (
        <section class="mt-14" aria-label="Frequently asked questions">
          <h2 class="font-heading text-2xl font-semibold tracking-tight text-ink-900">Frequently asked questions</h2>
          <div class="mt-6 divide-y divide-cream-200 overflow-hidden rounded-2xl border border-cream-300 bg-cream-50">
            {faqs.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-5">
                  <span class="font-semibold text-ink-900">{f.question}</span>
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-cream-300 text-ink-600 transition-transform group-open:rotate-45">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </summary>
                <p class="px-5 pb-6 -mt-1 text-[15px] leading-relaxed text-ink-600">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="card-white mt-14 flex flex-col items-start gap-4 p-7 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-heading text-xl font-semibold text-ink-900">Turn aftercare into retention and referrals.</p>
          <p class="mt-1 text-sm text-ink-600">Start free for 14 days. Live in about 20 minutes.</p>
        </div>
        <a href="/start" data-cta="post-start" class="btn-primary shrink-0">Start free trial</a>
      </div>

      <section class="mt-16" aria-label="Related reading">
        <h2 class="font-heading text-xl font-semibold tracking-tight text-ink-900">Keep reading</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {related.map((p) => (
            <a href={`/blog/${p.slug}`} class="card card-lift block p-5">
              <span class="eyebrow text-teal-700">{p.tags[0]}</span>
              <span class="mt-2 block font-semibold leading-snug text-ink-900">{p.title}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>
