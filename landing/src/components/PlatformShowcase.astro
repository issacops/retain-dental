---
---

<section class="py-24 px-6 bg-ink-950 relative overflow-hidden" id="platform">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-violet-600/5 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-6">
      <h2 class="font-sans font-[400] text-4xl md:text-5xl tracking-tight text-onDark-100 max-w-4xl mx-auto leading-tight">
        Run entirely through <span class="font-serif italic text-violet-400">one branded patient app.</span>
      </h2>
      <p class="text-center text-text-onDark-500 font-sans max-w-2xl mx-auto mb-16 mt-6 leading-relaxed">
        A single white-labeled experience for every patient touchpoint — scheduling, loyalty, aftercare, and recall. No app store friction.
      </p>
    </div>

    <!-- Pattern B — First Instance (large bleeding dashboard stage) -->
    <div class="relative mb-24">
      <div class="absolute -inset-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-violet-600/10 via-transparent to-transparent pointer-events-none"></div>

      <div class="relative bg-ink-900 rounded-3xl border border-ink-border overflow-hidden" style="padding-bottom: 0;">
        <div class="p-8 md:p-12 pb-0" style="margin-bottom: -60px;">
          <!-- Header bar -->
          <div class="flex items-center gap-3 mb-8 pb-5 border-b border-ink-border">
            <div class="w-7 h-7 rounded-lg bg-violet-600 flex items-center justify-center">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span class="text-sm font-sans text-onDark-100">RetainOS Platform: Bright Smile Dental <span class="text-text-onDark-500">▾</span></span>
          </div>

          <div class="flex gap-8">
            <!-- Left sidebar -->
            <div class="hidden md:flex flex-col gap-5 shrink-0">
              <div class="relative flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-violet-600/20 flex items-center justify-center">
                  <svg class="w-5 h-5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                </div>
                <div class="absolute -left-3 w-0.5 h-10 rounded-full bg-violet-600"></div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-ink-800 flex items-center justify-center">
                  <svg class="w-5 h-5 text-text-onDark-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-ink-800 flex items-center justify-center">
                  <svg class="w-5 h-5 text-text-onDark-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-ink-800 flex items-center justify-center">
                  <svg class="w-5 h-5 text-text-onDark-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                </div>
              </div>
            </div>

            <!-- Main content area -->
            <div class="flex-1 min-w-0">
              <!-- 4x2 Metadata grid -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-5 mb-10">
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Practice Name</p>
                  <p class="text-sm text-onDark-100 font-sans">Bright Smile Dental</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">PMS Integration</p>
                  <p class="text-sm text-onDark-100 font-sans">Dentrix</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Active Patients</p>
                  <p class="text-sm text-onDark-100 font-sans">2,847</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Recall Sequences</p>
                  <p class="text-sm text-onDark-100 font-sans">4 active</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Loyalty Tiers</p>
                  <p class="text-sm text-onDark-100 font-sans">3 (Silver/Gold/Platinum)</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Avg Redemption</p>
                  <p class="text-sm text-onDark-100 font-sans">68%</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Aftercare Active</p>
                  <p class="text-sm text-onDark-100 font-sans">312</p>
                </div>
                <div>
                  <p class="text-xs text-text-onDark-500 font-sans mb-1">Treatment Types</p>
                  <p class="text-sm text-onDark-100 font-sans">7</p>
                </div>
              </div>

              <!-- Retention Trend chart -->
              <div>
                <div class="flex items-center justify-between mb-3">
                  <p class="text-xs font-semibold text-text-onDark-500 uppercase tracking-[0.08em]">Retention Trend</p>
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-violet-600"></span>
                    <span class="text-[10px] text-text-onDark-500">Monthly</span>
                  </div>
                </div>
                <div class="relative h-36">
                  <svg viewBox="0 0 400 140" class="w-full h-full" preserveAspectRatio="none">
                    <line x1="0" y1="0" x2="400" y2="0" stroke="#2E1E40" stroke-width="1"/>
                    <line x1="0" y1="35" x2="400" y2="35" stroke="#2E1E40" stroke-width="1"/>
                    <line x1="0" y1="70" x2="400" y2="70" stroke="#2E1E40" stroke-width="1"/>
                    <line x1="0" y1="105" x2="400" y2="105" stroke="#2E1E40" stroke-width="1"/>
                    <line x1="0" y1="140" x2="400" y2="140" stroke="#2E1E40" stroke-width="1"/>
                    <defs>
                      <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#7C5CFF" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#7C5CFF" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <path d="M0,130 L0,95 C20,88 40,85 60,78 C80,72 100,68 120,62 C140,55 160,50 180,45 C200,40 220,35 240,30 C260,25 280,22 300,18 C320,15 340,12 360,10 C380,8 400,6 L400,140 L0,140 Z" fill="url(#chartGrad)"/>
                    <path d="M0,95 C20,88 40,85 60,78 C80,72 100,68 120,62 C140,55 160,50 180,45 C200,40 220,35 240,30 C260,25 280,22 300,18 C320,15 340,12 360,10 C380,8 400,6" fill="none" stroke="#7C5CFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="0" cy="95" r="3" fill="#170B1C" stroke="#7C5CFF" stroke-width="2"/>
                    <circle cx="80" cy="72" r="3" fill="#170B1C" stroke="#7C5CFF" stroke-width="2"/>
                    <circle cx="160" cy="50" r="3" fill="#170B1C" stroke="#7C5CFF" stroke-width="2"/>
                    <circle cx="240" cy="30" r="3" fill="#170B1C" stroke="#7C5CFF" stroke-width="2"/>
                    <circle cx="320" cy="15" r="3" fill="#170B1C" stroke="#7C5CFF" stroke-width="2"/>
                    <circle cx="400" cy="6" r="4" fill="#7C5CFF" stroke="#170B1C" stroke-width="2.5"/>
                  </svg>
                </div>
              </div>

              <!-- Recent Activity feed (bleeds off bottom) -->
              <div class="mt-6 pt-5 border-t border-ink-border">
                <div class="flex items-center justify-between mb-3">
                  <p class="text-xs font-semibold text-text-onDark-500 uppercase tracking-[0.08em]">Recent Activity</p>
                </div>
                <div class="space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-violet-600"></div>
                    <p class="text-[11px] text-onDark-100">Sarah Johnson redeemed 500 pts for teeth whitening</p>
                    <span class="text-[9px] text-text-onDark-500 ml-auto">2m ago</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-violet-400"></div>
                    <p class="text-[11px] text-onDark-100">Mike Chen completed aftercare checklist — Day 3</p>
                    <span class="text-[9px] text-text-onDark-500 ml-auto">18m ago</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-violet-200"></div>
                    <p class="text-[11px] text-onDark-100">New review: "Best dental experience ever!" — 5★</p>
                    <span class="text-[9px] text-text-onDark-500 ml-auto">1h ago</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-violet-600"></div>
                    <p class="text-[11px] text-onDark-100">Recall sequence triggered for 12 patients</p>
                    <span class="text-[9px] text-text-onDark-500 ml-auto">3h ago</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pattern B — Second Instance (smaller, with side copy) -->
    <div class="grid lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3">
        <div class="bg-ink-900 rounded-3xl border border-ink-border overflow-visible">
          <div class="p-6 md:p-8" style="margin-bottom: -30px;">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-ink-border">
              <div class="w-6 h-6 rounded-lg bg-violet-600/20 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <span class="text-xs font-sans text-onDark-100">Analytics <span class="text-text-onDark-500">▾</span></span>
            </div>

            <div class="relative h-48">
              <svg viewBox="0 0 400 160" class="w-full h-full" preserveAspectRatio="none">
                <line x1="0" y1="0" x2="400" y2="0" stroke="#2E1E40" stroke-width="1"/>
                <line x1="0" y1="40" x2="400" y2="40" stroke="#2E1E40" stroke-width="1"/>
                <line x1="0" y1="80" x2="400" y2="80" stroke="#2E1E40" stroke-width="1"/>
                <line x1="0" y1="120" x2="400" y2="120" stroke="#2E1E40" stroke-width="1"/>
                <line x1="0" y1="160" x2="400" y2="160" stroke="#2E1E40" stroke-width="1"/>
                <defs>
                  <linearGradient id="chartGrad2" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.25"/>
                    <stop offset="100%" stop-color="#A78BFA" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,150 L0,120 C40,110 80,105 120,95 C160,85 200,78 240,65 C280,52 320,43 360,35 C380,32 400,28 L400,160 L0,160 Z" fill="url(#chartGrad2)"/>
                <path d="M0,120 C40,110 80,105 120,95 C160,85 200,78 240,65 C280,52 320,43 360,35 C380,32 400,28" fill="none" stroke="#A78BFA" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="0" cy="120" r="2.5" fill="#170B1C" stroke="#A78BFA" stroke-width="1.5"/>
                <circle cx="80" cy="105" r="2.5" fill="#170B1C" stroke="#A78BFA" stroke-width="1.5"/>
                <circle cx="160" cy="85" r="2.5" fill="#170B1C" stroke="#A78BFA" stroke-width="1.5"/>
                <circle cx="240" cy="65" r="3" fill="#170B1C" stroke="#A78BFA" stroke-width="1.5"/>
                <circle cx="320" cy="43" r="4" fill="#A78BFA" stroke="#170B1C" stroke-width="2"/>
                <circle cx="400" cy="28" r="2.5" fill="#170B1C" stroke="#A78BFA" stroke-width="1.5"/>
                <line x1="320" y1="43" x2="320" y2="15" stroke="#A78BFA" stroke-width="1" stroke-dasharray="3,2"/>
                <circle cx="320" cy="15" r="1.5" fill="#A78BFA"/>
              </svg>

              <div class="absolute top-2 right-8 bg-ink-800 border border-violet-600/30 rounded-xl px-3 py-2 shadow-lg shadow-violet-600/10">
                <p class="text-[10px] text-onDark-100 font-sans whitespace-nowrap">Recall Conversion — March: <span class="text-violet-400 font-semibold">87% ± 4%</span></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4 leading-snug">
          That cuts no-shows, lifts reviews, and <span class="font-serif italic text-violet-400">grows recurring revenue.</span>
        </h3>
        <p class="text-text-onDark-500 font-sans leading-relaxed">
          Every module works together in one platform — from the first recall ping to the tenth loyalty reward. No integrations to stitch. No data to export.
        </p>
      </div>
    </div>
  </div>
</section>
