---
const screens = [
  { src: '/platform/clinic-pulse.webp', alt: 'Practice Pulse dashboard with revenue, active patients, and chair time', label: 'Practice Pulse', w: 1440, h: 900 },
  { src: '/platform/clinic-retention.webp', alt: 'Retention Intelligence dashboard with retention rate and tier distribution', label: 'Retention Intelligence', w: 1440, h: 900 },
  { src: '/platform/patient-wallet.webp', alt: 'Patient wallet with membership tier and Smile Points', label: 'Patient wallet', w: 430, h: 930 },
  { src: '/platform/patient-care.webp', alt: 'Aftercare checklist with daily rituals and adherence', label: 'Aftercare', w: 430, h: 930 },
  { src: '/platform/patient-family.webp', alt: 'Family hub with pooled points', label: 'Family hub', w: 430, h: 930 },
  { src: '/platform/clinic-schedule.webp', alt: 'Appointment schedule across the practice', label: 'Schedule', w: 1440, h: 900 },
  { src: '/platform/clinic-social.webp', alt: 'Social studio with branded post templates', label: 'Social studio', w: 1440, h: 900 },
  { src: '/platform/platform-network.webp', alt: 'Multi-location network hub for DSOs', label: 'Network hub', w: 1440, h: 900 },
]
---
<section id="screens" class="scroll-mt-24 bg-ink-900 py-20 sm:py-28 text-cream-100">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-300">Product tour</p>
        <h2 class="mt-4 font-heading text-[clamp(1.9rem,3.6vw,3rem)] font-semibold leading-[1.06] tracking-tight text-balance">
          See the whole system.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cream-100/70">
          The clinic workspace, the patient app, and the retention engine, real screens from the platform.
        </p>
      </div>
      <a href="/start" data-cta="tour-start" class="shrink-0 inline-flex items-center gap-2 rounded-full bg-teal-500 px-6 py-3 font-semibold text-ink-900 hover:bg-teal-400 transition-colors">
        Try it free
      </a>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {screens.map((s) => (
        <figure class="overflow-hidden rounded-2xl border border-white/10 bg-ink-800">
          <div class="h-56 overflow-hidden bg-cream-50">
            <img src={s.src} srcset={s.w === 1440 ? `${s.src.replace('.webp', '-720.webp')} 720w, ${s.src} 1440w` : undefined} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 24vw" width={s.w} height={s.h} alt={s.alt} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
          </div>
          <figcaption class="border-t border-white/10 px-4 py-3 eyebrow text-cream-100/60">{s.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
