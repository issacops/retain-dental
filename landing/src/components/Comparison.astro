---
const rows = [
  { label: 'Where patients live', old: 'Scattered across SMS, email, and paper', now: 'One branded app you own' },
  { label: 'Aftercare', old: 'A printed sheet and a hope', now: 'A daily checklist in the app, with adherence tracked' },
  { label: 'Recall', old: 'Someone remembers to call', now: 'Automated, multi-channel, on time' },
  { label: 'Rewards', old: 'A discount code nobody uses', now: 'Points, tiers, and family pooling' },
  { label: 'Referrals', old: 'A favour you hope for', now: 'A built-in loop patients get rewarded for' },
  { label: 'Reviews', old: 'Asked for at random', now: 'Requested at the moment of highest trust' },
  { label: 'Your brand', old: 'Invisible between visits', now: 'On the patient\u2019s home screen' },
  { label: 'Time to launch', old: 'Weeks of setup and training', now: 'About 20 minutes' },
]
---
<section class="bg-cream-100 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="eyebrow text-teal-700">The difference</p>
      <h2 class="mt-4 font-heading text-[clamp(1.9rem,3.6vw,3rem)] font-semibold leading-[1.06] tracking-tight text-ink-900 text-balance">
        The old way, and the Retain Dental way.
      </h2>
    </div>

    <div class="mt-12 overflow-hidden rounded-3xl border border-cream-300 bg-cream-50">
      <div class="grid grid-cols-3 gap-4 border-b border-cream-200 px-6 py-4 sm:px-8">
        <span class="eyebrow text-ink-400">What matters</span>
        <span class="eyebrow text-ink-400">The old way</span>
        <span class="eyebrow text-teal-700">Retain Dental</span>
      </div>
      {rows.map((r) => (
        <div class="grid grid-cols-3 gap-4 border-b border-cream-200 px-6 py-5 last:border-b-0 sm:px-8">
          <span class="text-[15px] font-semibold text-ink-900">{r.label}</span>
          <span class="text-[15px] leading-relaxed text-ink-500">{r.old}</span>
          <span class="flex items-start gap-2 text-[15px] font-medium leading-relaxed text-ink-800">
            <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-teal-100 text-teal-700">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            {r.now}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
