---
const oldWay = [
  "Patients call to book — and hang up if you don\u2019t answer",
  "Front desk spends 15+ min per recall call",
  "Paper new-patient forms at every visit",
  "Missed appointments cost $200+ per no-show",
  "No visibility into who\u2019s due for treatment",
  "Whitening and elective offers buried in voicemail",
];

const retainBenefits = [
  "Patients book online 24/7 in under 60 seconds",
  "Automated recall sequences bring 40% more back",
  "Digital forms filled before they walk in",
  "Smart reminders cut no-shows by 60%+",
  "Dashboard shows every patient\u2019s next due date",
  "Push treatment plans and offers to their phone",
];
---

<section class="bg-paper-50 py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-4xl font-bold tracking-tight text-text-900 sm:text-5xl">
        Old Way <span class="italic text-violet-600">vs.</span> RetainOS
      </h2>
      <p class="mt-4 text-lg text-text-600">
        See why hundreds of DSOs and private practices are making the switch.
      </p>
    </div>

    <div
      class="mx-auto mt-16 grid max-w-5xl gap-8 md:grid-cols-2"
    >
      <div class="rounded-2xl border border-paper-line bg-white px-8 py-10">
        <h3
          class="flex items-center gap-3 text-xl font-bold text-text-900"
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-paper-line bg-paper-50 text-sm text-text-600"
            aria-hidden="true"
          >
            &#10005;
          </span>
          Old Way
        </h3>
        <ul class="mt-8 space-y-5">
          {oldWay.map((item) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-sm text-text-600"
                aria-hidden="true"
              >
                &#10005;
              </span>
              <span class="text-base text-text-600">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="rounded-2xl border border-violet-200 bg-violet-200/20 px-8 py-10"
      >
        <h3
          class="flex items-center gap-3 text-xl font-bold text-text-900"
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-600 text-white"
            aria-hidden="true"
          >
            &#10003;
          </span>
          RetainOS
        </h3>
        <ul class="mt-8 space-y-5">
          {retainBenefits.map((item) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-violet-600"
                aria-hidden="true"
              >
                &#10003;
              </span>
              <span class="text-base text-text-900">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full border border-violet-600 px-8 py-3 text-sm font-semibold text-violet-600 transition-colors hover:bg-violet-600 hover:text-white"
      >
        See the full platform
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
