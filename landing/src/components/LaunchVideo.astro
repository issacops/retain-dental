---
---
<section class="bg-cream-100 pb-4 pt-20 sm:pt-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="eyebrow text-teal-700">See it in motion</p>
      <h2 class="mt-4 font-heading text-[clamp(1.8rem,3.4vw,2.6rem)] font-semibold leading-[1.08] tracking-tight text-ink-900 text-balance">
        Fifty seconds inside Retain Dental.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        From the front desk to the patient's home screen, and back again as a referral.
      </p>
    </div>

    <div class="mt-10 overflow-hidden rounded-3xl border border-cream-300 bg-ink-900 shadow-lift">
      <video
        class="block w-full"
        poster="/video/retain-dental-tour.jpg"
        controls
        preload="none"
        playsinline
        width="1280"
        height="720"
      >
        <source src="/video/retain-dental-tour.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</section>
