---
const steps = [
  {
    n: '01',
    title: 'Make it your clinic’s app',
    body: 'Add your logo, colors, and name. Your app looks like you built it, because to your patients, you did.',
  },
  {
    n: '02',
    title: 'Bring your patients',
    body: 'Import your patient list or connect your PMS. No migration project, no downtime, no IT team required.',
  },
  {
    n: '03',
    title: 'Assign aftercare, go live',
    body: 'Send your first aftercare plan and recall, and watch patients follow through, then come back and refer.',
  },
]
---
<section id="how" class="scroll-mt-24 bg-cream-50 py-20 sm:py-28">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">How it works</p>
      <h2 class="mt-4 font-heading text-[clamp(1.9rem,3.6vw,3rem)] font-semibold leading-[1.06] tracking-tight text-ink-900 text-balance">
        Your branded app, live in 20 minutes.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        No dev team. No migration. No meetings. Just your practice, finally running retention and referrals on one platform.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <div class="relative card p-8">
          <span class="font-mono text-sm font-semibold text-teal-600">{s.n}</span>
          <h3 class="mt-4 font-heading text-xl font-semibold tracking-tight text-ink-900">{s.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{s.body}</p>
          {i < steps.length - 1 && (
            <span aria-hidden="true" class="absolute -right-3 top-1/2 hidden h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full border border-cream-300 bg-cream-50 text-ink-400 md:flex">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          )}
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <a href="/start" data-cta="how-start" class="inline-flex items-center gap-2 rounded-full bg-teal-600 px-7 py-3.5 font-semibold text-white shadow-card hover:bg-teal-700 transition-colors">
        Start free trial
      </a>
      <p class="text-sm text-ink-500">14 days free | No credit card | Cancel anytime</p>
    </div>
  </div>
</section>
