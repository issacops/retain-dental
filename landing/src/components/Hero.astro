---
export interface Props {}
---

<section id="hero" class="relative min-h-[90vh] flex items-center pt-28 overflow-hidden bg-cream-50">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-terracotta-100/30 via-cream-50 to-cream-50"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="space-y-8 py-12">
        <span class="text-[11px] font-semibold text-terracotta-600 uppercase tracking-[0.15em]">Replace 6 tools with 1 platform</span>

        <h1 class="text-5xl md:text-7xl font-display font-[540] leading-[1.05] text-clay-900">
          Stop Renting Patients.<br />
          Start <span class="text-terracotta-600">Owning Them.</span>
        </h1>

        <div class="speakable-summary sr-only">
          RetainOS replaces your recall software, loyalty platform, patient portal, review generator, payment terminal, and analytics — with one branded patient app your patients actually use. DSO-ready, HIPAA-aware, and live in 20 minutes.
        </div>

        <p class="text-lg md:text-xl text-clay-700 font-sans max-w-lg leading-relaxed">
          RetainOS replaces <strong class="text-clay-900 font-semibold">6 separate tools</strong> — recall automation, loyalty platform, patient portal, review generator, payment terminal, and analytics — with one branded app your patients actually use.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="javascript:void(0)" onclick="window.dispatchEvent(new Event('open-demo-form'))" class="group px-8 py-4 bg-terracotta-600 text-white rounded font-semibold text-lg hover:bg-terracotta-500 transition-all flex items-center justify-center gap-2">
            Build My App
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="px-8 py-4 border border-clay-700 text-clay-700 rounded font-semibold text-lg hover:bg-clay-100 transition-all flex items-center justify-center gap-2">
            See How It Works
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
        </div>

        <div class="flex items-center gap-6">
          <div class="flex -space-x-3">
            <div class="w-10 h-10 rounded-full bg-terracotta-100 flex items-center justify-center text-[10px] font-bold text-clay-900 shrink-0">SC</div>
            <div class="w-10 h-10 rounded-full bg-terracotta-100 flex items-center justify-center text-[10px] font-bold text-clay-900 shrink-0">MT</div>
            <div class="w-10 h-10 rounded-full bg-terracotta-100 flex items-center justify-center text-[10px] font-bold text-clay-900 shrink-0">PS</div>
            <div class="w-10 h-10 rounded-full bg-terracotta-100 flex items-center justify-center text-[10px] font-bold text-clay-900 shrink-0">JO</div>
          </div>
          <span class="text-sm text-clay-500">
            <span class="text-clay-900 font-semibold">12 pilot clinics</span> worldwide
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-2 pt-2 text-xs text-clay-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sage-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            No code required
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sage-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Works with Dentrix, Eaglesoft + Open Dental
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sage-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Live in 20 minutes
          </span>
        </div>
      </div>

      <div class="relative flex justify-center lg:justify-end py-8">
        <div class="relative w-[260px] sm:w-[300px] md:w-[320px]">
          <div class="rounded-[2.5rem] shadow-[0_8px_24px_rgba(43,29,20,0.08)] ring-1 ring-clay-100/50 overflow-hidden bg-cream-50">
            <img src="/assets/screens/patient-mobile.png" alt="RetainOS white-label patient app — branded loyalty wallet, daily care rituals, and automated recall" class="w-full h-auto block" width="472" height="765" loading="eager" decoding="async" />
          </div>
          <div class="absolute -top-3 -right-3 sm:-top-4 sm:-right-4 bg-cream-0 backdrop-blur-xl border border-clay-100 p-3 sm:p-4 rounded-xl shadow-[0_8px_24px_rgba(43,29,20,0.08)] hidden md:block">
            <div class="flex items-center gap-3">
              <div>
                <p class="text-[10px] font-bold text-clay-500 uppercase tracking-[0.12em] leading-tight">Patient Retention</p>
                <p class="text-xl font-bold text-terracotta-600 leading-none mt-0.5">96.4%</p>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-3 -left-3 sm:-bottom-4 sm:-left-4 bg-cream-0 backdrop-blur-xl border border-clay-100 p-3 sm:p-4 rounded-xl shadow-[0_8px_24px_rgba(43,29,20,0.08)] hidden md:block">
            <div class="flex items-center gap-3">
              <div>
                <p class="text-[10px] font-bold text-clay-500 uppercase tracking-[0.12em] leading-tight">Time to Launch</p>
                <p class="text-xl font-bold text-terracotta-600 leading-none mt-0.5">20 min</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
