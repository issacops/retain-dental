<section class="relative min-h-[650px] flex items-center overflow-hidden bg-ink-950">
  <div class="absolute inset-0 bg-gradient-to-b from-ink-950/40 via-ink-950/60 to-ink-950/30 pointer-events-none z-10"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(99,102,241,0.15),transparent)] pointer-events-none"></div>

  <div class="relative z-20 w-full max-w-7xl mx-auto px-6 pt-28 pb-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-white/80 text-xs font-semibold uppercase tracking-[0.12em]">Replace 6 tools with 1 platform</span>
        </div>
        <h1 class="text-[clamp(2.5rem,5vw,4.5rem)] font-black text-white leading-[1.05] tracking-tighter text-balance">
          Patient retention is constant.<br />
          <span class="text-violet-400">RetainOS brings the calm.</span>
        </h1>
        <p class="text-[clamp(1.115rem,2vw,1.25rem)] text-white/80 max-w-[600px] mt-6 leading-relaxed">
          Smart tools to automate recalls, build loyalty, and free up your team's day.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-10">
          <button onclick="window.dispatchEvent(new Event('open-demo-form'))" class="inline-flex items-center gap-2 rounded-[32px] px-8 py-4 bg-white text-dark-blue font-semibold text-lg hover:opacity-90 transition-all duration-200 shadow-sm">
            Book a demo
            <span class="ml-1">→</span>
          </button>
          <a href="#features" class="inline-flex items-center gap-2 text-white font-semibold text-lg hover:text-white/80 transition-colors duration-200 min-h-[48px] py-2">
            See how it works <span>→</span>
          </a>
        </div>

        <!-- Social proof row -->
        <div class="mt-12 flex flex-wrap items-center gap-6">
          <div class="flex -space-x-2">
            {['SC', 'MT', 'PS', 'JO'].map((initials) => (
              <div class="w-9 h-9 rounded-full bg-violet-600/30 border-2 border-ink-950 flex items-center justify-center text-[10px] font-bold text-violet-400">
                {initials}
              </div>
            ))}
          </div>
          <div>
            <p class="text-sm font-semibold text-white">12 pilot clinics worldwide</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-1 mt-1 text-xs text-white/50">
              <span class="flex items-center gap-1.5">
                <svg class="w-3 h-3 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                No code required
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-3 h-3 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                Live in 20 minutes
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-3 h-3 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                HIPAA ready
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Phone mockup -->
      <div class="hidden lg:flex justify-center items-center relative">
        <div class="relative w-[320px] h-[660px]">
          <div class="absolute inset-0 rounded-[3rem] bg-ink-900 border-4 border-ink-border shadow-2xl shadow-violet-600/10 overflow-hidden">
            <div class="h-8 bg-ink-800 flex items-center justify-between px-6">
              <span class="text-[10px] text-white/50 font-medium">9:41</span>
              <div class="flex items-center gap-1.5">
                <svg class="w-3 h-3 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 9l4 4-4 4"/><path d="M7 17l10-10"/></svg>
                <svg class="w-3 h-3 text-white/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/></svg>
              </div>
            </div>
            <div class="p-5 pt-3 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-[11px] text-white/50 font-medium">Welcome back</p>
                  <p class="text-sm font-semibold text-white">RetainOS Clinic</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-violet-600 flex items-center justify-center">
                  <span class="text-white text-[10px] font-bold">RC</span>
                </div>
              </div>
              <div class="rounded-2xl bg-gradient-to-br from-violet-600/20 to-ink-800 border border-violet-600/20 p-4">
                <p class="text-[10px] text-white/50 uppercase tracking-wider">Your Points</p>
                <p class="text-2xl font-bold text-white mt-1">2,450 <span class="text-sm font-normal text-violet-400">pts</span></p>
                <div class="w-full h-1.5 rounded-full bg-ink-700 mt-2">
                  <div class="w-3/4 h-full rounded-full bg-violet-400"></div>
                </div>
                <p class="text-[10px] text-violet-400 mt-1">250 pts until Gold tier</p>
              </div>
              <div class="grid grid-cols-2 gap-2.5">
                {[
                  { label: 'Book Visit', icon: 'calendar' },
                  { label: 'Pay Bill', icon: 'card' },
                ].map((action) => (
                  <div class="rounded-xl bg-ink-800 border border-ink-border p-3 flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-violet-600/20 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        {action.icon === 'calendar' ? (
                          <>
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                          </>
                        ) : (
                          <>
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                          </>
                        )}
                      </svg>
                    </div>
                    <p class="text-xs font-medium text-white">{action.label}</p>
                  </div>
                ))}
              </div>
              <div class="rounded-xl bg-ink-800 border border-ink-border p-3.5">
                <div class="flex items-center justify-between mb-2">
                  <p class="text-[10px] text-white/50 uppercase tracking-wider">Upcoming Recall</p>
                  <span class="px-2 py-0.5 rounded-full bg-violet-600/20 text-[9px] text-violet-400 font-medium">Day 3</span>
                </div>
                <p class="text-xs font-medium text-white">Sarah Johnson — Cleaning & Checkup</p>
                <p class="text-[10px] text-white/50 mt-0.5">Tomorrow at 10:30 AM</p>
              </div>
              <div class="flex items-center justify-around pt-2 border-t border-ink-border">
                {['Home', 'Wallet', 'Care', 'Profile'].map((tab) => (
                  <div class="flex flex-col items-center gap-0.5">
                    <div class={`w-1 h-1 rounded-full ${tab === 'Home' ? 'bg-violet-400' : 'bg-transparent'}`}></div>
                    <p class={`text-[9px] ${tab === 'Home' ? 'text-violet-400 font-medium' : 'text-white/50'}`}>{tab}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="absolute -inset-8 bg-gradient-to-br from-violet-600/20 via-transparent to-transparent blur-3xl pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2">
    <span class="text-white/50 text-xs font-medium">Scroll</span>
    <svg width="14" height="22" viewBox="0 0 14 22" fill="none" class="animate-bounce text-white/50">
      <rect x="1.5" y="1.5" width="11" height="19" rx="5.5" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="7" cy="7" r="1.5" fill="currentColor" class="animate-pulse"/>
    </svg>
  </div>
</section>
