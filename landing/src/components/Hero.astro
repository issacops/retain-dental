---
const activities = [
  { text: 'Aftercare checklist completed' },
  { text: 'Gold tier unlocked | +1,500 pts' },
  { text: 'Patient shared points with a friend' },
  { text: 'Recall sent to 42 overdue patients' },
  { text: 'Family pool reached 1,850 pts' },
]
---
<section class="relative overflow-hidden bg-cream-100 pt-28 pb-16 sm:pt-36 sm:pb-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-32 -left-24 h-[36rem] w-[36rem] rounded-full bg-teal-200/40 blur-[120px]"></div>
    <div class="absolute top-24 right-0 h-[32rem] w-[32rem] rounded-full bg-sky-100/70 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
      <!-- Copy -->
      <div class="max-w-xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/70 px-4 py-1.5 text-[13px] font-medium text-teal-800">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
          The branded clinic app for aftercare, retention &amp; referrals
        </p>

        <h1 class="mt-6 font-heading text-[clamp(2.3rem,5.2vw,3.9rem)] font-semibold leading-[1.03] tracking-tight text-ink-900 text-balance">
          Aftercare your patients brag about.
        </h1>

        <p class="mt-6 text-[clamp(1.05rem,1.6vw,1.25rem)] leading-relaxed text-ink-600 text-pretty">
          Retain Dental gives your clinic its own branded app, where every patient follows their aftercare, earns points, and brings their friends. Every visit becomes a retention and referral engine, automatically.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a
            href="/start"
            data-cta="hero-start"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-teal-600 px-7 py-3.5 text-base font-semibold text-white shadow-card hover:bg-teal-700 transition-colors min-h-[52px]"
          >
            Start free trial
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a
            href="#how"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-ink-900/15 bg-white/60 px-7 py-3.5 text-base font-semibold text-ink-900 hover:bg-white transition-colors min-h-[52px]"
          >
            See the 20-minute setup
          </a>
        </div>

        <p class="mt-5 text-[13px] text-ink-500">
          No credit card | Your logo, your colors | HIPAA-aligned | Live in 20 minutes
        </p>

        <!-- Live loop ticker -->
        <div class="mt-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-400">The retention loop, running now</p>
          <div id="ticker" class="mt-3 flex flex-wrap gap-2.5" aria-live="polite">
            {activities.map((a, i) => (
              <span
                data-tick={i}
                class:list={[
                  'tick inline-flex items-center gap-2 rounded-full border border-cream-300 bg-white/80 px-3.5 py-2 text-[13px] font-medium text-ink-700 transition-all duration-500',
                  i === 0 ? 'opacity-100' : 'opacity-40',
                ]}
              >
                <span class="h-2 w-2 rounded-full bg-teal-500"></span>
                {a.text}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Visual: aftercare-first patient app + clinic dashboard -->
      <div class="relative">
        <div class="relative mx-auto max-w-[560px]">
          <div class="overflow-hidden rounded-3xl border border-cream-300 bg-white shadow-lift">
            <div class="flex items-center gap-2 border-b border-cream-200 bg-cream-50 px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
              <span class="ml-3 font-mono text-[11px] text-ink-500">app.retaindental.com/clinic</span>
            </div>
            <img
              src="/platform/clinic-retention.webp"
              srcset="/platform/clinic-retention-720.webp 720w, /platform/clinic-retention.webp 1440w"
              sizes="(max-width: 1024px) 92vw, 560px"
              width="1440"
              height="900"
              alt="Clinic dashboard showing retention intelligence, adherence, and patient engagement"
              class="block w-full"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <!-- Floating patient aftercare app (the hook) -->
          <div class="absolute -bottom-8 -left-6 w-[150px] sm:w-[178px]">
            <div class="overflow-hidden rounded-[2rem] border-[6px] border-ink-900 bg-ink-900 shadow-lift">
              <img
                src="/platform/patient-care.webp"
                width="430"
                height="930"
                alt="Patient aftercare checklist in the clinic's branded app, with daily rituals and progress"
                class="block w-full"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Floating referral stat -->
          <div class="absolute -right-4 top-10 rounded-2xl border border-cream-300 bg-white px-4 py-3 shadow-card">
            <p class="eyebrow text-ink-500">Referred patients</p>
            <p class="font-heading text-2xl font-semibold text-teal-700">2.3×</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const ticks = Array.from(document.querySelectorAll('#ticker .tick'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (ticks.length && !reduce) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % ticks.length;
      ticks.forEach((t, idx) => {
        t.classList.toggle('opacity-100', idx === i);
        t.classList.toggle('opacity-40', idx !== i);
      });
    }, 2600);
  }
</script>
