---
export interface Props {}
---

<section id="hero" class="relative min-h-screen flex items-stretch bg-ink-950">
  <!-- Left: Patient photo placeholder -->
  <!--
    PHOTO SPEC:
    - Candid patient smiling with a dentist/hygienist, warm natural lighting
    - Portrait orientation, min 800px wide
    - Duotone treatment: wrap <img> in a container with a pseudo-element overlay
      using mix-blend-mode and bg-violet-400/20 so the right half gets a violet tint
    - Replace the placeholder div below with:
      <div class="absolute inset-0 overflow-hidden mix-blend-multiply">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-violet-400/20 z-10"></div>
        <img src="..." alt="..." class="w-full h-full object-cover" />
      </div>
  -->
  <div class="hidden lg:block w-1/2 relative min-h-screen">
    <div class="absolute inset-0 bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950 flex items-center justify-center">
      <span class="text-onDark-500 text-xs font-sans">PORTRAIT PLACEHOLDER — Replace with candid patient photo</span>
    </div>
  </div>

  <!-- Right: Content -->
  <div class="w-full lg:w-1/2 relative flex items-center min-h-screen">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-violet-600/10 via-ink-950 to-ink-950 pointer-events-none"></div>

    <div class="relative z-10 px-6 lg:px-16 py-24 lg:py-0 w-full max-w-2xl mx-auto lg:mx-0">
      <!-- Eyebrow -->
      <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.1em] font-sans">
        <span class="text-violet-400 mr-1.5">■</span>REPLACE 6 TOOLS WITH 1 PLATFORM
      </span>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl font-sans font-[400] text-onDark-100 leading-[1.08] tracking-tight mt-4">
        Turn every patient into <span class="font-serif italic text-violet-400">a referral engine.</span>
      </h1>

      <!-- Speakable summary (SEO) -->
      <div class="speakable-summary sr-only">
        RetainOS replaces your recall software, loyalty platform, patient portal, review generator, payment terminal, and analytics — with one branded patient app your patients actually use. DSO-ready, HIPAA-aware, and live in 20 minutes.
      </div>

      <!-- Subhead -->
      <p class="text-lg text-onDark-500 font-sans leading-relaxed max-w-lg mt-6">
        RetainOS turns every recall, reward, and reminder into a reason patients bring their family in too.
      </p>

      <!-- CTA Row -->
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a href="javascript:void(0)" onclick="window.dispatchEvent(new Event('open-demo-form'))" class="rounded-full px-8 py-4 bg-violet-600 text-white font-semibold text-lg hover:bg-violet-400 transition-all flex items-center justify-center gap-2">
          Build My App
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#how-it-works" class="rounded-full px-8 py-4 border border-onDark-500 text-onDark-100 font-semibold text-lg hover:bg-ink-800 transition-all flex items-center justify-center gap-2">
          See How It Works
        </a>
      </div>

      <!-- Constellation Avatar Network -->
      <div class="mt-12 flex items-center gap-6">
        <svg width="200" height="80" viewBox="0 0 200 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
          <!-- Root dot -->
          <circle cx="20" cy="40" r="8" fill="#7C5CFF"/>
          <!-- Connection lines -->
          <line x1="28" y1="40" x2="60" y2="20" stroke="#7C5CFF" stroke-width="1" opacity="0.5"/>
          <line x1="28" y1="40" x2="60" y2="60" stroke="#7C5CFF" stroke-width="1" opacity="0.5"/>
          <line x1="28" y1="40" x2="100" y2="40" stroke="#7C5CFF" stroke-width="1" opacity="0.5"/>
          <line x1="28" y1="40" x2="80" y2="15" stroke="#7C5CFF" stroke-width="1" opacity="0.4"/>
          <line x1="28" y1="40" x2="140" y2="25" stroke="#7C5CFF" stroke-width="1" opacity="0.4"/>
          <line x1="28" y1="40" x2="130" y2="55" stroke="#7C5CFF" stroke-width="1" opacity="0.3"/>
          <!-- Network dots -->
          <circle cx="60" cy="20" r="6" fill="#A78BFA"/>
          <circle cx="60" cy="60" r="5" fill="#A78BFA"/>
          <circle cx="100" cy="40" r="8" fill="#A78BFA"/>
          <circle cx="80" cy="15" r="4" fill="#A78BFA"/>
          <circle cx="140" cy="25" r="6" fill="#A78BFA"/>
          <circle cx="130" cy="55" r="3" fill="#A78BFA"/>
          <!-- +50 pts label -->
          <text x="148" y="28" fill="#A78BFA" font-size="9" font-family="Inter, sans-serif" font-weight="600">+50 pts</text>
        </svg>
      </div>

      <!-- Trust Row -->
      <div class="mt-8 space-y-4">
        <div class="flex items-center gap-4">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-violet-200 flex items-center justify-center text-[9px] font-bold text-ink-950 shrink-0">SC</div>
            <div class="w-8 h-8 rounded-full bg-violet-200 flex items-center justify-center text-[9px] font-bold text-ink-950 shrink-0">MT</div>
            <div class="w-8 h-8 rounded-full bg-violet-200 flex items-center justify-center text-[9px] font-bold text-ink-950 shrink-0">PS</div>
            <div class="w-8 h-8 rounded-full bg-violet-200 flex items-center justify-center text-[9px] font-bold text-ink-950 shrink-0">JO</div>
          </div>
          <span class="text-sm text-onDark-500 font-sans">12 pilot clinics worldwide</span>
        </div>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-xs text-onDark-500 font-sans">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            No code required
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Works with Dentrix, Eaglesoft + Open Dental
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Live in 20 minutes
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom-left scroll indicator -->
    <div class="absolute bottom-8 left-6 lg:left-16 flex flex-col items-center gap-2">
      <span class="text-onDark-500 text-xs font-sans">Scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="animate-bounce text-onDark-500">
        <rect x="1.5" y="1.5" width="13" height="21" rx="6.5" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="8" cy="8" r="2" fill="currentColor" class="animate-pulse"/>
      </svg>
    </div>
  </div>
</section>

<!-- Mobile photo block (below 768px, stacked after hero) -->
<div class="block lg:hidden bg-ink-950">
  <div class="bg-gradient-to-br from-ink-800 via-ink-900 to-ink-950 flex items-center justify-center h-64">
    <span class="text-onDark-500 text-xs font-sans">PORTRAIT PLACEHOLDER — Replace with candid patient photo</span>
  </div>
</div>
