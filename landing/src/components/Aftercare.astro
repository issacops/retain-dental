---
const aftercareSteps = [
  { day: '24h', label: 'Post-Treatment Check-in', desc: 'Automated SMS/email with aftercare instructions, prescribed product reminders, and a 1-tap satisfaction survey.', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { day: 'Day 3', label: 'Healing Progress Nudge', desc: 'Personalized check-in asking about recovery, with an option to schedule a follow-up if needed — no staff time required.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622' },
  { day: 'Day 7', label: 'Review Request + Referral', desc: 'Happy patient? They\'re prompted to leave a 5-star review and share a referral link with friends — auto-credited with Smile Points.', icon: 'M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5' },
  { day: 'Day 14', label: 'Recall Schedule Set', desc: 'Patient is auto-enrolled into their optimal recall cadence — 3-month, 6-month, or annual — based on treatment type.', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { day: 'Day 30', label: 'Loyalty Reward Earned', desc: 'First month\'s Smile Points auto-credited. Patient is now active in the loyalty ecosystem — recurring revenue begins.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
]
---

<section class="py-24 px-6 bg-cream-100 relative overflow-hidden">
  <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-teal-50/50 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 items-start">
      <div class="flex-1 space-y-8 lg:sticky lg:top-32">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-600 text-xs font-bold uppercase tracking-widest">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
          Aftercare Automation
        </div>

        <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tighter leading-tight">
          Turn every treatment into a<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-teal-600">30-day revenue engine</span>
        </h2>

        <p class="text-xl text-slate-500 leading-relaxed">
          Most clinics treat patients and <em class="text-slate-700">hope</em> they come back. RetainOS transforms the post-treatment window into a fully automated nurture sequence — driving reviews, referrals, and repeat bookings without your staff lifting a finger.
        </p>

        <div class="grid grid-cols-2 gap-4 pt-4">
          {[
            { stat: '87%', label: 'Patient engagement rate', color: 'text-teal-600' },
            { stat: '10h+', label: 'Staff hours saved / wk', color: 'text-teal-600' },
            { stat: '3.4x', label: 'More reviews generated', color: 'text-teal-600' },
            { stat: '96.4%', label: 'Long-term retention', color: 'text-amber-600' },
          ].map(s => (
            <div class="p-4 rounded-xl bg-cream-100/70 border border-gray-200/80">
              <p class={`text-2xl font-black ${s.color} mb-0.5`}>{s.stat}</p>
              <p class="text-xs text-slate-500 font-semibold">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="flex-1 w-full">
        <div class="relative">
          <div class="absolute -left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-teal-500/50 via-teal-500/30 to-transparent hidden lg:block"></div>
          <div class="space-y-6">
            {aftercareSteps.map((step, i) => (
              <div class="relative pl-8 lg:pl-10 group">
                <div class="absolute left-0 lg:left-[-17px] top-2 w-8 h-8 rounded-full bg-white border-2 border-teal-200/80 flex items-center justify-center group-hover:border-teal-400 group-hover:bg-teal-100/80 transition-all duration-300 z-10">
                  <span class="text-[9px] font-black text-teal-600">{step.day}</span>
                </div>
                <div class="p-5 rounded-2xl bg-cream-100/50 border border-gray-200/80 hover:border-teal-200/80 hover:bg-teal-50/50 transition-all duration-300">
                  <div class="flex items-start gap-4">
                    <div class="w-9 h-9 rounded-lg bg-teal-500/15 flex items-center justify-center shrink-0 mt-0.5">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon}/></svg>
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-3 mb-1">
                        <span class="text-[10px] font-bold text-teal-600 uppercase tracking-widest shrink-0">{step.day}</span>
                        <h3 class="text-base font-bold text-slate-900">{step.label}</h3>
                      </div>
                      <p class="text-sm text-slate-500 leading-relaxed">{step.desc}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 p-5 rounded-2xl bg-gradient-to-r from-teal-50 via-white to-teal-50 border border-teal-200/60">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-teal-100/80 flex items-center justify-center shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <p class="text-sm text-slate-700"><span class="text-teal-600 font-bold">Zero staff time</span> — the entire 30-day aftercare sequence runs on autopilot. Patients feel cared for. Your team stays productive.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
