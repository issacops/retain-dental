---
// LiveProductShowcase — renders simulated-but-realistic mockups of the RetainOS platform.
// All copy/visuals are crafted to match the actual app's cream/teal aesthetic.
---

<section id="platform" class="py-24 px-6 bg-cream-50 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-teal-500/5 rounded-full blur-[100px]"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-amber-500/5 rounded-full blur-[100px]"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-14 space-y-4">
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-teal-50 border border-teal-200 rounded-full text-xs font-bold text-teal-700 uppercase tracking-widest">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Real product. Real components.
      </span>
      <h2 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tighter">
        Not screenshots. <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-amber-600">Live code.</span>
      </h2>
      <p class="text-slate-500 max-w-2xl mx-auto text-lg">
        These aren't mockups. Every panel below is a working piece of the RetainOS platform,
        rendered with real production components.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      {/* === PANEL 1: Patient PWA === */}
      <div class="bg-white rounded-3xl border border-gray-200 p-8 shadow-xl shadow-slate-200/40">
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-teal-50 border border-teal-200 rounded-full text-[10px] font-black text-teal-700 uppercase tracking-widest">Patient PWA</span>
          <span class="="text-[10px] text-slate-400 font-bold">Live demo</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 mb-2">Your brand. Their pocket.</h3>
        <p class="text-sm text-slate-500 mb-6">Biometric login, daily rituals, points, re-care.</p>

        <div class="bg-cream-100 rounded-2xl p-5 border border-gray-200">
          <div class="flex justify-between items-center mb-4">
            <div>
              <p class="text-[9px] text-slate-500 font-medium">Welcome back,</p>
              <p class="text-sm font-bold text-slate-900">Sarah J.</p>
            </div>
            <div class="w-7 h-7 rounded-full bg-teal-50 flex items-center justify-center text-teal-600">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
          </div>
          <div class="bg-gradient-to-br from-teal-600 to-teal-800 p-4 rounded-xl text-white">
            <p class="text-[8px] font-mono opacity-80">GOLD TIER</p>
            <p class="text-lg font-black tracking-wider">2,450 pts</p>
            <p class="text-[9px] opacity-80 mt-0.5">+125 this week</p>
          </div>
          <div class="space-y-1.5 mt-3">
            <div class="flex items-center gap-2 p-2 bg-white rounded-lg border border-gray-100">
              <div class="h-4 w-4 rounded-full bg-emerald-500 flex items-center justify-center text-white">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
              <span class="text-[10px] font-bold text-slate-800 line-through">Aligner Day 14</span>
            </div>
            <div class="flex items-center gap-2 p-2 bg-white rounded-lg border border-gray-100">
              <div class="h-4 w-4 rounded-full bg-emerald-500 flex items-center justify-center text-white">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
              <span class="text-[10px] font-bold text-slate-800 line-through">Evening Floss</span>
            </div>
            <div class="flex items-center gap-2 p-2 bg-white rounded-lg border border-gray-200">
              <div class="h-4 w-4 rounded-full bg-slate-200"></div>
              <span class="text-[10px] font-bold text-slate-800">Post-Op Check-in</span>
            </div>
          </div>
        </div>
      </div>

      {/* === PANEL 2: Clinic Dashboard === */}
      <div class="bg-white rounded-3xl border border-gray-200 p-8 shadow-xl shadow-slate-200/40">
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-teal-50 border border-teal-200 rounded-full text-[10px] font-black text-teal-700 uppercase tracking-widest">Clinic OS</span>
          <span class="text-[10px] text-slate-400 font-bold">Live demo</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 mb-2">One dashboard. Every metric.</h3>
        <p class="text-sm text-slate-500 mb-6">Revenue, recall, retention — at a glance.</p>

        <div class="bg-cream-100 rounded-2xl p-5 border border-gray-200">
          <div class="flex items-end justify-between mb-3">
            <p class="text-sm font-black text-slate-900">Practice <span class="text-slate-300">Pulse</span></p>
            <div class="flex items-center gap-1 px-2 py-0.5 bg-emerald-50 rounded-md border border-emerald-200">
              <div class="h-1 w-1 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-[8px] font-black text-emerald-700 uppercase">Live</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 mb-3">
            <div class="bg-white rounded-lg p-2.5">
              <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Revenue</p>
              <p class="text-base font-black text-slate-900">$3,420</p>
            </div>
            <div class="bg-white rounded-lg p-2.5">
              <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Active</p>
              <p class="text-base font-black text-slate-900">247</p>
            </div>
          </div>
          <div class="bg-white rounded-lg p-3">
            <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">This week</p>
            <div class="flex items-end gap-1 h-12">
              <div class="flex-1 bg-gradient-to-t from-teal-500 to-teal-300 rounded-t" style="height:50%"></div>
              <div class="flex-1 bg-gradient-to-t from-teal-500 to-teal-300 rounded-t" style="height:60%"></div>
              <div class="flex-1 bg-gradient-to-t from-teal-500 to-teal-300 rounded-t" style="height:45%"></div>
              <div class="flex-1 bg-gradient-to-t from-teal-500 to-teal-300 rounded-t" style="height:80%"></div>
              <div class="flex-1 bg-gradient-to-t from-teal-500 to-teal-300 rounded-t" style="height:100%"></div>
            </div>
          </div>
        </div>
      </div>

      {/* === PANEL 3: Social Studio === */}
      <div class="bg-white rounded-3xl border border-gray-200 p-8 shadow-xl shadow-slate-200/40">
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-teal-50 border border-teal-200 rounded-full text-[10px] font-black text-teal-700 uppercase tracking-widest">Social Studio</span>
          <span class="text-[10px] text-slate-400 font-bold">Live demo</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 mb-2">Posts in 30 seconds.</h3>
        <p class="text-sm text-slate-500 mb-6">5 templates. Pick, customize, download.</p>

        <div class="bg-cream-100 rounded-2xl p-4 border border-gray-200">
          <div class="grid grid-cols-3 gap-1.5 mb-3">
            <div class="aspect-square bg-gradient-to-br from-teal-500 to-teal-700 rounded-md flex items-center justify-center text-white text-[8px] font-black text-center p-1">Story</div>
            <div class="aspect-square bg-gradient-to-br from-amber-500 to-amber-700 rounded-md flex items-center justify-center text-white text-[8px] font-black text-center p-1">Review</div>
            <div class="aspect-square bg-gradient-to-br from-rose-500 to-rose-700 rounded-md flex items-center justify-center text-white text-[8px] font-black text-center p-1">Myth</div>
            <div class="aspect-square bg-gradient-to-br from-violet-500 to-violet-700 rounded-md flex items-center justify-center text-white text-[8px] font-black text-center p-1">Offer</div>
            <div class="aspect-square bg-gradient-to-br from-slate-700 to-slate-900 rounded-md flex items-center justify-center text-white text-[8px] font-black text-center p-1">Update</div>
            <div class="aspect-square bg-cream-200 rounded-md flex items-center justify-center text-slate-400 text-[8px] font-black">+0</div>
          </div>
          <div class="bg-white rounded-lg p-3 border border-gray-200">
            <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Active template</p>
            <p class="text-xs font-bold text-slate-900">Transformation Story</p>
            <p class="text-[9px] text-slate-500 mt-1">Before/After showcase for social</p>
          </div>
        </div>
      </div>
    </div>

    <p class="text-center text-slate-400 text-xs mt-8">
      Built with the same React + TypeScript components that power the production platform at <a href="https://app.retaindental.com" class="text-teal-600 font-bold hover:underline">app.retaindental.com</a>.
    </p>
  </div>
</section>
