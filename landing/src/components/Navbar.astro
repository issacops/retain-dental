---
const links = [
  { href: '/#features', label: 'Platform' },
  { href: '/#how', label: 'How it works' },
  { href: '/blog', label: 'Stories' },
  { href: '/about', label: 'Company' },
]
---
<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="flex items-center justify-between h-[72px]">
      <a href="/" class="flex items-center shrink-0 py-2" aria-label="Retain Dental home">
        <img src="/brand/lockup-dark.png" alt="Retain Dental" width="760" height="177" class="h-8 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-9" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} class="text-[15px] font-medium text-ink-700 hover:text-ink-900 transition-colors">{l.label}</a>
        ))}
      </nav>

      <div class="hidden md:flex items-center gap-3">
        <a href="https://app.retaindental.com" class="text-[15px] font-medium text-ink-700 hover:text-ink-900 transition-colors px-3 py-2">Sign in</a>
        <a
          href="/start"
          data-cta="nav-start"
          class="inline-flex items-center gap-2 rounded-full bg-teal-600 px-5 py-2.5 text-[15px] font-semibold text-white shadow-soft hover:bg-teal-700 transition-colors min-h-[44px]"
        >
          Start free trial
        </a>
      </div>

      <button
        id="menu-toggle"
        class="md:hidden inline-flex items-center justify-center h-11 w-11 rounded-xl border border-cream-300 text-ink-800"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-cream-300 bg-cream-50/95 backdrop-blur-xl">
    <nav class="mx-auto max-w-8xl px-5 py-4 flex flex-col" aria-label="Mobile">
      {links.map((l) => (
        <a href={l.href} class="py-3 text-base font-medium text-ink-800 border-b border-cream-200">{l.label}</a>
      ))}
      <a href="https://app.retaindental.com" class="py-3 text-base font-medium text-ink-800 border-b border-cream-200">Sign in</a>
      <a href="/start" data-cta="nav-start" class="mt-4 inline-flex items-center justify-center rounded-full bg-teal-600 px-5 py-3 text-base font-semibold text-white">Start free trial</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 12) {
      header.classList.add('bg-cream-50/85', 'backdrop-blur-xl', 'border-b', 'border-cream-200');
    } else {
      header.classList.remove('bg-cream-50/85', 'backdrop-blur-xl', 'border-b', 'border-cream-200');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
