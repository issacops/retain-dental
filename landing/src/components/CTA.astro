---
---

<section class="bg-ink-950 py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="text-4xl font-bold tracking-tight text-onDark-100 sm:text-5xl"
      >
        Ready to stop renting patients
        <br />
        and start <span class="italic text-violet-400">owning them?</span>
      </h2>
      <p class="mt-6 text-lg text-onDark-500">
        Join 20+ clinics already growing their practice with a branded patient
        app. No dev team. No long contract. Go live in 20 minutes.
      </p>
      <div class="mt-10">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-demo-form'))"
          class="inline-flex items-center gap-2 rounded-full bg-violet-600 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-violet-500"
        >
          Build My App
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <div
        class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8"
      >
        <div class="flex items-center gap-2 text-sm text-onDark-500">
          <svg
            class="h-5 w-5 text-violet-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.5 12.75l6 6 9-13.5"
            />
          </svg>
          Free onboarding
        </div>
        <div class="flex items-center gap-2 text-sm text-onDark-500">
          <svg
            class="h-5 w-5 text-violet-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.5 12.75l6 6 9-13.5"
            />
          </svg>
          HIPAA compliant
        </div>
        <div class="flex items-center gap-2 text-sm text-onDark-500">
          <svg
            class="h-5 w-5 text-violet-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.5 12.75l6 6 9-13.5"
            />
          </svg>
          No dev team needed
        </div>
      </div>
    </div>
  </div>
</section>
