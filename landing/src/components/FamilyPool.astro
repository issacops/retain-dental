---
const benefits = [
  { label: 'Shared point balance', desc: 'Every family member contributes to and draws from one pool. Parents earn on their visits; kids redeem for whitening.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { label: 'Family dashboard', desc: 'Single view of all family members\' upcoming appointments, point balances, and treatment history.', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { label: 'Multi-patient recall', desc: 'One automated sequence covers the whole family. Mom\'s hygiene, Dad\'s crown work, kids\' checkups — all synced.', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { label: 'Caregiver controls', desc: 'Parents manage bookings, consent forms, and rewards for minors from their own app login.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622' },
]
---

<section class="py-24 px-6 bg-cream-100 relative overflow-hidden">
  <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] bg-teal-50/50 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 items-center">
      <div class="flex-1 order-2 lg:order-1 w-full">
        <div class="rounded-[2rem] bg-white border border-gray-200 p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex -space-x-2">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 border-2 border-gray-200 flex items-center justify-center text-xs font-black text-slate-900 shrink-0">JD</div>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-rose-500 to-rose-700 border-2 border-gray-200 flex items-center justify-center text-xs font-black text-slate-900 shrink-0">AK</div>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 border-2 border-gray-200 flex items-center justify-center text-xs font-black text-slate-900 shrink-0">MK</div>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 border-2 border-gray-200 flex items-center justify-center text-xs font-black text-slate-900 shrink-0">SK</div>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">The Davis Family</p>
              <p class="text-xs text-slate-500">4 members · 2,340 Smile Points</p>
            </div>
          </div>

          <div class="space-y-3 mb-6">
            <div class="flex items-center justify-between p-3 bg-cream-100/70 rounded-xl">
              <div class="flex items-center gap-3 min-w-0">
<div class="w-8 h-8 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 shrink-0"></div>
                  <div class="min-w-0">
                    <p class="text-sm font-bold text-slate-900 truncate">James (Dad)</p>
                  <p class="text-xs text-slate-500 truncate">Next: Crown check — Mar 15</p>
                </div>
              </div>
              <span class="shrink-0 text-sm font-bold text-amber-600">1,240 pts</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-cream-100/70 rounded-xl">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-rose-500 to-rose-700 shrink-0"></div>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-900 truncate">Anna (Mom)</p>
                  <p class="text-xs text-slate-500 truncate">Next: Hygiene — Apr 2</p>
                </div>
              </div>
              <span class="shrink-0 text-sm font-bold text-amber-600">860 pts</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-cream-100/70 rounded-xl">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500 to-amber-700 shrink-0"></div>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-900 truncate">Mia (12)</p>
                  <p class="text-xs text-slate-500 truncate">Next: Checkup — Jun 10</p>
                </div>
              </div>
              <span class="shrink-0 text-sm font-bold text-amber-600">160 pts</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-cream-100/70 rounded-xl">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-teal-500 to-teal-700 shrink-0"></div>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-slate-900 truncate">Sam (8)</p>
                  <p class="text-xs text-slate-500 truncate">Next: Checkup — Jun 10</p>
                </div>
              </div>
              <span class="shrink-0 text-sm font-bold text-amber-600">80 pts</span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-gradient-to-r from-teal-50 to-amber-50 border border-cyan-700/20">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-teal-600 font-bold uppercase tracking-widest">Family Pool Total</p>
                <p class="text-2xl font-black text-slate-900">2,340 pts</p>
              </div>
              <span class="px-3 py-1.5 bg-amber-100/80 text-amber-600 rounded-lg text-xs font-bold">Platinum Tier</span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex-1 space-y-8 order-1 lg:order-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-600 text-xs font-bold uppercase tracking-widest">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          Family Pool
        </div>

        <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tighter leading-tight">
          One family.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-amber-600">One loyalty pool.</span>
        </h2>

        <p class="text-xl text-slate-500 leading-relaxed">
          Dental care is a family decision. RetainOS Family Pool lets you capture <strong class="text-slate-900">the entire household</strong> under one loyalty roof — shared points, unified scheduling, and automated care for every member.
        </p>

        <div class="space-y-5">
          {benefits.map(item => (
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-xl bg-teal-50/80 flex items-center justify-center shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
              </div>
              <div class="min-w-0">
                <p class="text-slate-900 font-bold">{item.label}</p>
                <p class="text-sm text-slate-500">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="pt-4">
          <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-cream-100/70 border border-gray-200/80">
            <svg class="w-5 h-5 text-teal-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-slate-500"><span class="text-slate-900 font-bold">68% higher LTV</span> for family-pooled patients vs. single-member accounts</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
