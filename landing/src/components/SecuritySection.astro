---
const items = [
  { title: 'HIPAA-aligned by design', body: 'We sign a Business Associate Agreement (BAA) with every practice and handle PHI with encryption in transit and at rest.' },
  { title: 'SOC 2 Type II, in progress', body: 'We are actively working toward SOC 2 Type II. We will share our current security documentation during your demo.' },
  { title: 'Your data stays yours', body: 'Role-based access controls, audit logging, and the ability to export your data at any time. No lock-in.' },
]
---
<section class="bg-cream-100 py-16 sm:py-20">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="card p-8 sm:p-12">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">Security &amp; compliance</p>
          <h2 class="mt-4 font-heading text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-[1.08] tracking-tight text-ink-900 text-balance">
            Built for patient data, not bolted on.
          </h2>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-600">
            Dental data deserves healthcare-grade handling. We build to that standard from day one.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {items.map((i) => (
            <div class="card-white p-5">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-100 text-teal-700">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
              </span>
              <h3 class="mt-3 font-heading text-sm font-semibold text-ink-900">{i.title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-ink-600">{i.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
