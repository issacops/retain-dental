<section id="faq" class="py-24 px-6 bg-paper-50" itemscope itemtype="https://schema.org/FAQPage">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <h2 class="font-sans font-[400] text-4xl md:text-5xl tracking-tight">
        Frequently asked <span class="font-serif italic text-violet-600">questions.</span>
      </h2>
      <p class="text-text-600 font-sans text-lg">Everything you need to know about RetainOS.</p>
    </div>

    <div class="max-w-3xl mx-auto">
      {[
        { q: 'How fast can I get my branded app live?', a: 'Most clinics go live in under 20 minutes. We handle app store submission, branding, and configuration — you just provide your logo and preferences.' },
        { q: 'Do patients need to download a new app?', a: 'Yes — your patients download your custom-branded app from the Apple App Store and Google Play. They use it to book appointments, earn loyalty points, make payments, and receive recall notifications.' },
        { q: 'How does the pricing work?', a: 'Plans start at $299/month per location with no long-term contract. All modules — loyalty, recall, payments, analytics — are included. Volume discounts are available for multi-location groups.' },
        { q: 'Does RetainOS integrate with my existing PMS?', a: 'Yes, we integrate with the major Practice Management Systems including Dentrix, Eaglesoft, Open Dental, and more. Our team handles the integration during onboarding.' },
        { q: 'What happens if a patient misses their appointment?', a: 'RetainOS automatically triggers a reactivation sequence — an SMS reminder, a push notification, and a follow-up email over 3 days. Your team doesn\'t lift a finger.' },
        { q: 'Is my patient data secure?', a: 'Yes. RetainOS is built on a HIPAA-ready architecture with AES-256 encryption at rest and TLS 1.3 in transit. SOC 2 Type II certification is in progress; BAA documentation is available on Enterprise plans.' },
        { q: 'Can patients earn rewards on paid treatments?', a: 'Absolutely. You define the earning rules — points per dollar, bonus points for specific treatments, and VIP tier multipliers. Patients redeem points toward future services.' },
        { q: 'What support do you provide during onboarding?', a: 'You get a dedicated onboarding specialist who walks your team through configuration, staff training, and patient launch. Ongoing support is available via in-app chat and email.' }
      ].map((faq) => (
        <details class="group border-b border-paper-line py-5">
          <summary class="flex justify-between items-center cursor-pointer list-none">
            <span class="text-base font-sans font-[500] text-text-900 pr-4">{faq.q}</span>
            <svg class="w-5 h-5 text-text-600 shrink-0 group-open:rotate-180 group-open:text-violet-600 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p class="mt-4 text-text-600 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
