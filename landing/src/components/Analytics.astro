---
// Env-gated analytics. Every tag only renders when its PUBLIC_* id is set,
// so the site never ships a broken or blocking script in local/preview builds.
// Public measurement ID. Env var overrides; the default makes GA work on deploy
// without extra configuration.
const GA4 = import.meta.env.PUBLIC_GA4_ID || 'G-5J8B78RGYN';
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID;
const META_PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID;
const LINKEDIN = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID;
const GOOGLE_ADS = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const hasGoogle = GA4 || GOOGLE_ADS;
const hasAny = GA4 || CLARITY || META_PIXEL || LINKEDIN || GOOGLE_ADS;
---

{hasAny && (
  <>
    <script is:inline define:vars={{ GA4, CLARITY, META_PIXEL, LINKEDIN, GOOGLE_ADS }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());

      // Consent Mode v2. Ad signals stay denied until the visitor opts in.
      // Analytics storage is granted so GA4 can measure by default; the cookie
      // banner can flip this to denied.
      function readConsent() {
        try { return localStorage.getItem('retain_consent'); } catch (e) { return null; }
      }
      var stored = readConsent();
      var granted = stored === 'granted';
      gtag('consent', 'default', {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: stored === 'denied' ? 'denied' : 'granted',
        wait_for_update: 500,
      });

      window.__retain_set_consent = function (accept) {
        try { localStorage.setItem('retain_consent', accept ? 'granted' : 'denied'); } catch (e) {}
        if (window.gtag) window.gtag('consent', 'update', {
          ad_storage: accept ? 'granted' : 'denied',
          ad_user_data: accept ? 'granted' : 'denied',
          ad_personalization: accept ? 'granted' : 'denied',
          analytics_storage: accept ? 'granted' : 'denied',
        });
      };

      if (GA4 || GOOGLE_ADS) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + (GA4 || GOOGLE_ADS);
        document.head.appendChild(s);
        if (GA4) gtag('config', GA4, { anonymize_ip: true });
        if (GOOGLE_ADS) gtag('config', GOOGLE_ADS);
      }

      if (CLARITY) {
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY);
      }

      if (META_PIXEL) {
        !function (f, b, e, v, n, t, s) {
          if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
          if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
          t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', META_PIXEL);
        window.fbq('track', 'PageView');
      }

      if (LINKEDIN) {
        window._linkedin_partner_id = LINKEDIN;
        window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
        window._linkedin_data_partner_ids.push(LINKEDIN);
        var l = document.createElement('script'); l.async = true;
        l.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
        document.head.appendChild(l);
      }

      // Single conversion hook used by every CTA and the onboarding.
      window.__retain_track = function (name, params) {
        try {
          if (window.gtag) window.gtag('event', name, params || {});
          if (window.fbq) window.fbq('trackCustom', name, params || {});
          if (window.clarity) window.clarity('event', name);
        } catch (e) {}
      };
    </script>
    <noscript>
      {META_PIXEL && <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${META_PIXEL}&ev=PageView&noscript=1`} />}
    </noscript>
    {hasGoogle && (
      <div
        id="cookie-banner"
        hidden
        style="position:fixed;left:16px;right:16px;bottom:16px;z-index:90;max-width:520px;margin:0 auto;border-radius:18px;border:1px solid #E7E1D6;background:#FBF9F5;box-shadow:0 24px 48px -20px rgba(18,33,43,.35);padding:18px 20px;"
      >
        <p style="margin:0;font:400 14px/1.5 'Geist',system-ui,sans-serif;color:#2C414E;">
          We use a few cookies to understand how the site is used. You can accept them or keep only what is essential.
        </p>
        <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;">
          <button id="cookie-accept" type="button" style="border:0;border-radius:999px;background:#0D9488;color:#fff;font:600 14px 'Geist',system-ui,sans-serif;padding:10px 18px;cursor:pointer;">Accept</button>
          <button id="cookie-reject" type="button" style="border:1px solid rgba(18,33,43,.14);border-radius:999px;background:#fff;color:#12212B;font:600 14px 'Geist',system-ui,sans-serif;padding:10px 18px;cursor:pointer;">Essential only</button>
        </div>
      </div>
      <script is:inline>
        (function () {
          var KEY = 'retain_consent';
          var banner = document.getElementById('cookie-banner');
          var stored = null;
          try { stored = localStorage.getItem(KEY); } catch (e) {}
          if (!stored && banner) {
            banner.hidden = false;
            var done = function (accept) {
              if (window.__retain_set_consent) window.__retain_set_consent(accept);
              banner.hidden = true;
            };
            document.getElementById('cookie-accept').addEventListener('click', function () { done(true); });
            document.getElementById('cookie-reject').addEventListener('click', function () { done(false); });
          }
        })();
      </script>
    )}
  </>
)}
