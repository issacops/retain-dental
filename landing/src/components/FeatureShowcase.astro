---
import FeaturePatientPwa from './demos/FeaturePatientPwa';
import FeatureRecall from './demos/FeatureRecall';
import FeatureAftercare from './demos/FeatureAftercare';
import FeatureLoyalty from './demos/FeatureLoyalty';
import FeatureSocial from './demos/FeatureSocial';
import FeatureReviews from './demos/FeatureReviews';
import FeatureDashboard from './demos/FeatureDashboard';

const features = [
  {
    id: 'patient-app',
    number: '01',
    title: 'Patient App',
    headline: 'Your branded app. Patients actually use it.',
    description: 'A progressive web app with wallet, care rituals, scheduling, and loyalty — white-labeled to your clinic. No app store needed.',
    details: ['Digital wallet with loyalty points', 'Daily care rituals with tap-to-complete', 'Household family pooling', 'In-app appointment booking'],
    component: 'FeaturePatientPwa',
    align: 'left',
  },
  {
    id: 'recall',
    number: '02',
    title: 'Automated Recall',
    headline: '3x more patients come back automatically.',
    description: 'Multi-channel sequences that bring back no-show patients without a single manual phone call.',
    details: ['SMS + email + push sequences', 'Missed-appointment reactivation', 'Post-treatment aftercare follow-ups', 'Zero manual phone calls needed'],
    component: 'FeatureRecall',
    align: 'right',
  },
  {
    id: 'aftercare',
    number: '03',
    title: 'Aftercare Checklists',
    headline: 'Aftercare that follows up itself.',
    description: 'Automated, procedure-specific checklists that text and email patients exactly when they need it.',
    details: ['Procedure-specific task templates', 'Automated SMS/email reminders', 'Progress tracking with confirmations', 'Integration with recall scheduling'],
    component: 'FeatureAftercare',
    align: 'left',
  },
  {
    id: 'loyalty',
    number: '04',
    title: 'Loyalty Engine',
    headline: 'Points, tiers & family pooling.',
    description: 'A loyalty program patients actually engage with. Member → Gold → Platinum tiers with household pooling that drives 68% higher lifetime value.',
    details: ['Points for visits, referrals, reviews', '3-tier VIP progression', 'Household point pooling', 'Reward redemption catalog'],
    component: 'FeatureLoyalty',
    align: 'right',
  },
  {
    id: 'social',
    number: '05',
    title: 'Social Studio',
    headline: 'AI-powered social content in seconds.',
    description: 'Generate branded social posts from templates — transformation stories, myth busters, reviews, and offers.',
    details: ['5 post templates (Trust, Education, Sales)', 'Auto-branded with your logo + colors', 'Download or share to Instagram', '87% faster recall response rate'],
    component: 'FeatureSocial',
    align: 'left',
  },
  {
    id: 'dashboard',
    number: '06',
    title: 'Analytics Dashboard',
    headline: 'All your metrics. One dashboard.',
    description: 'Revenue, retention, reviews, and loyalty — all in one real-time dashboard. No more spreadsheet wrangling.',
    details: ['Real-time KPI tracking', 'Retention trend charts', 'Household leaderboard', 'Churn risk alerts with AI insights'],
    component: 'FeatureDashboard',
    align: 'right',
  },
];
---

<section class="relative py-24 px-6 bg-ink-900 overflow-hidden border-b border-white/5" id="features">
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="text-xs font-semibold text-violet-400 uppercase tracking-[0.15em] mb-4">How RetainOS works</p>
      <h2 class="text-[clamp(1.75rem,3.5vw,2.75rem)] font-bold text-white leading-[1.05] tracking-tight text-balance">
        A retention system, not a point solution
      </h2>
      <p class="text-white/70 text-[clamp(1rem,1.5vw,1.125rem)] mt-4 max-w-2xl mx-auto">
        One platform that works as one, so nothing falls through.
      </p>
    </div>

    {features.map((feature, idx) => (
      <div class="mb-16 last:mb-0">
        <div class={`grid lg:grid-cols-2 gap-10 lg:gap-16 items-center ${feature.align === 'right' ? '' : ''}`}>
          {feature.align === 'left' ? (
            <>
              <div>
                <span class="text-[40px] font-black text-white/20 leading-none">{feature.number}</span>
                <div class="flex items-center gap-2 mt-2 mb-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="text-xs font-semibold text-white/80 uppercase tracking-[0.12em]">{feature.title}</span>
                </div>
                <h3 class="text-[clamp(1.5rem,2.5vw,1.75rem)] font-black text-white leading-[1.1] tracking-tighter mb-4">{feature.headline}</h3>
                <p class="text-white/70 leading-relaxed mb-6">{feature.description}</p>
                <div class="space-y-2">
                  {feature.details.map((detail) => (
                    <div class="flex items-center gap-2.5 text-sm text-white/70">
                      <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      {detail}
                    </div>
                  ))}
                </div>
                <div class="mt-4 text-xs text-white/50">
                  <span class="font-semibold text-white/80">Works with:</span> Integrates with scheduling, billing, and patient data
                </div>
              </div>
              <div>
                {feature.component === 'FeaturePatientPwa' && <FeaturePatientPwa client:visible />}
                {feature.component === 'FeatureRecall' && <FeatureRecall client:visible />}
                {feature.component === 'FeatureAftercare' && <FeatureAftercare client:visible />}
                {feature.component === 'FeatureLoyalty' && <FeatureLoyalty client:visible />}
                {feature.component === 'FeatureSocial' && <FeatureSocial client:visible />}
                {feature.component === 'FeatureDashboard' && <FeatureDashboard client:visible />}
                {feature.component === 'FeatureReviews' && <FeatureReviews client:visible />}
              </div>
            </>
          ) : (
            <>
              <div class="order-2 lg:order-1">
                {feature.component === 'FeaturePatientPwa' && <FeaturePatientPwa client:visible />}
                {feature.component === 'FeatureRecall' && <FeatureRecall client:visible />}
                {feature.component === 'FeatureAftercare' && <FeatureAftercare client:visible />}
                {feature.component === 'FeatureLoyalty' && <FeatureLoyalty client:visible />}
                {feature.component === 'FeatureSocial' && <FeatureSocial client:visible />}
                {feature.component === 'FeatureDashboard' && <FeatureDashboard client:visible />}
                {feature.component === 'FeatureReviews' && <FeatureReviews client:visible />}
              </div>
              <div class="order-1 lg:order-2">
                <span class="text-[40px] font-black text-white/20 leading-none">{feature.number}</span>
                <div class="flex items-center gap-2 mt-2 mb-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="text-xs font-semibold text-white/80 uppercase tracking-[0.12em]">{feature.title}</span>
                </div>
                <h3 class="text-[clamp(1.5rem,2.5vw,1.75rem)] font-black text-white leading-[1.1] tracking-tighter mb-4">{feature.headline}</h3>
                <p class="text-white/70 leading-relaxed mb-6">{feature.description}</p>
                <div class="space-y-2">
                  {feature.details.map((detail) => (
                    <div class="flex items-center gap-2.5 text-sm text-white/70">
                      <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      {detail}
                    </div>
                  ))}
                </div>
                <div class="mt-4 text-xs text-white/50">
                  <span class="font-semibold text-white/80">Works with:</span> Integrates with scheduling, billing, and patient data
                </div>
              </div>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
