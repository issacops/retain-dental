---
const features = [
  {
    tag: 'Aftercare',
    title: 'Aftercare that follows up, and gets brag-worthy.',
    body: 'Assign a protocol from the dashboard and it lands in your branded app as a daily checklist: aligners, post-op, whitening. Patients feel looked after, adherence is tracked, and your team stops chasing.',
    img: '/platform/patient-care.webp',
    alt: 'Patient aftercare checklist with daily rituals and progress',
    kind: 'phone',
  },
  {
    tag: 'Your app',
    title: 'A custom app with your clinic’s name on it.',
    body: 'Your logo, your colors, your name. Patients open your app, not a generic portal, for aftercare, booking, balances, and rewards. No App Store wait; add to home screen in one tap.',
    img: '/platform/patient-wallet.webp',
    alt: 'Clinic-branded patient app wallet with membership tier and points',
    kind: 'phone',
  },
  {
    tag: 'Retention',
    title: 'Points that bring them back.',
    body: 'Every treatment and every check-in earns points. Tiers get perks, and household pooling turns one patient into a family, so the next visit is already booked in their mind.',
    img: '/platform/patient-family.webp',
    alt: 'Family hub showing linked members and a pooled points balance',
    kind: 'phone',
  },
  {
    tag: 'Referrals',
    title: 'Your patients, your best marketing.',
    body: 'When a friend needs a dentist, your patient shares your name, and their points. Referral rewards turn gratitude into new patients, automatically.',
    img: '/platform/patient-rewards.webp',
    alt: 'Rewards ledger showing points earned and referral bonuses',
    kind: 'phone',
  },
  {
    tag: 'Recall',
    title: 'Recalls that run themselves.',
    body: 'Overdue patients get the right nudge at the right time, automatically. Bring back the patients you already paid to acquire.',
    img: '/platform/clinic-patient.webp',
    alt: 'Patient record with contact details and booking controls',
    kind: 'desk',
  },
  {
    tag: 'Insight',
    title: 'See exactly what’s working.',
    body: 'Retention rate, adherence, referrals, and lifetime value in one dashboard, so you can double down on the things that actually grow the practice.',
    img: '/platform/clinic-retention.webp',
    alt: 'Retention Intelligence dashboard with retention rate and tier distribution',
    kind: 'desk',
  },
]
---
<section id="features" class="scroll-mt-24 bg-cream-100 py-20 sm:py-28">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">The platform</p>
      <h2 class="mt-4 font-heading text-[clamp(1.9rem,3.6vw,3rem)] font-semibold leading-[1.06] tracking-tight text-ink-900 text-balance">
        One branded app. Aftercare, retention and referrals in one place.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">
        Everything a patient touches between visits lives in your own app, and everything your team needs to grow lives in one dashboard.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="group flex flex-col overflow-hidden card card-lift">
          <div class="relative h-60 overflow-hidden border-b border-cream-200 bg-gradient-to-br from-teal-50 via-cream-50 to-sky-100">
            {f.kind === 'phone' ? (
              <div class="absolute left-1/2 top-9 w-[38%] -translate-x-1/2 overflow-hidden rounded-[1.4rem] border-[5px] border-ink-900 bg-ink-900 shadow-card transition-transform duration-500 group-hover:-translate-y-1.5">
                <img src={f.img} width="430" height="930" alt={f.alt} loading="lazy" decoding="async" class="block w-full" />
              </div>
            ) : (
              <div class="absolute left-1/2 top-9 w-[86%] -translate-x-1/2 overflow-hidden rounded-xl border border-ink-900/10 bg-white shadow-card transition-transform duration-500 group-hover:-translate-y-1.5">
                <div class="flex items-center gap-1.5 border-b border-cream-200 bg-cream-50 px-3 py-2">
                  <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
                  <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
                  <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
                </div>
                <img src={f.img} srcset={`${f.img.replace('.webp', '-720.webp')} 720w, ${f.img} 1440w`} sizes="(max-width: 768px) 88vw, 420px" width="1440" height="900" alt={f.alt} loading="lazy" decoding="async" class="block w-full" />
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-7">
            <p class="eyebrow text-teal-700">{f.tag}</p>
            <h3 class="mt-3 font-heading text-xl font-semibold tracking-tight text-ink-900">{f.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{f.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
