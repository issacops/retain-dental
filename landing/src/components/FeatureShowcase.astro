---
import FeaturePatientPwa from './demos/FeaturePatientPwa';
import FeatureRecall from './demos/FeatureRecall';
import FeatureAftercare from './demos/FeatureAftercare';
import FeatureLoyalty from './demos/FeatureLoyalty';
import FeatureSocial from './demos/FeatureSocial';
import FeatureReviews from './demos/FeatureReviews';
import FeatureDashboard from './demos/FeatureDashboard';
---

<section class="relative py-32 px-6 bg-ink-950 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-violet-600/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
        <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Features</span>
      </span>
      <h2 class="text-4xl md:text-5xl font-sans font-[400] text-onDark-100 tracking-tight leading-tight text-balance">
        See RetainOS <span class="font-serif italic text-violet-400">in action.</span>
      </h2>
    </div>

    <!-- Feature 1: Patient PWA (text left) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Patient PWA</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">Your branded app. Patients actually use it.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">A progressive web app with wallet, care rituals, scheduling, and loyalty — white-labeled to your clinic. No app store needed.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Digital wallet with loyalty points
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Daily care rituals with tap-to-complete
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Household family pooling
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              In-app appointment booking
            </li>
          </ul>
        </div>
        <div>
          <FeaturePatientPwa client:load />
        </div>
      </div>
    </div>

    <!-- Feature 2: Recall Automation (text right) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <FeatureRecall client:load />
        </div>
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Recall Automation</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">3x more patients come back automatically.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">Automated multi-channel sequences that bring back no-show patients without a single manual phone call.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              SMS + email + push sequences
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Missed-appointment reactivation
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Post-treatment aftercare follow-ups
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Zero manual phone calls needed
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Feature 3: Aftercare (text left) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Aftercare Checklists</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">Aftercare that <span class="font-serif italic text-violet-400">follows up itself.</span></h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">Automated, procedure-specific checklists text and email patients exactly when they need it — so nothing falls through after they leave the chair.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Procedure-specific task templates (root canal, implant, extraction, whitening)
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Automated SMS/email reminders timed to recovery milestones
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Progress tracking with completion confirmations
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Integration with recall scheduling for Day 7 follow-up booking
            </li>
          </ul>
        </div>
        <div>
          <FeatureAftercare client:load />
        </div>
      </div>
    </div>

    <!-- Feature 4: Loyalty Engine (text right) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <FeatureLoyalty client:load />
        </div>
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Loyalty Engine</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">Points, tiers & family pooling.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">A loyalty program patients actually engage with. Silver → Gold → Platinum tiers with household pooling that drives 68% higher lifetime value.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Points for visits, referrals, reviews
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              3-tier VIP progression
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Household point pooling
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Reward redemption catalog
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Feature 5: Social Studio (text left) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Social Studio</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">AI-powered social content in seconds.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">Generate branded social posts from templates — transformation stories, myth busters, reviews, and offers — with your clinic's branding baked in.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              5 post templates (Trust, Education, Sales)
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Auto-branded with your logo + colors
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Download or share directly to Instagram
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              87% faster recall response rate
            </li>
          </ul>
        </div>
        <div>
          <FeatureSocial client:load />
        </div>
      </div>
    </div>

    <!-- Feature 6: Reviews (text right) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <FeatureReviews client:load />
        </div>
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Review Collection</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">3.4x more reviews. Automatically.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">Automated post-visit review requests that grow your Google rating. Happy patients get prompted at exactly the right moment.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Timed review requests (Day 7)
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              SMS with direct review link
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              92% response rate
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Verified review badges
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Feature 7: Dashboard (text left) -->
    <div class="mb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-600/10 border border-violet-600/20 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
            <span class="text-violet-400 text-xs font-semibold uppercase tracking-[0.12em]">Analytics Dashboard</span>
          </span>
          <h3 class="font-sans font-[400] text-2xl md:text-3xl text-onDark-100 tracking-tight mb-4">All your metrics. One dashboard.</h3>
          <p class="text-text-onDark-500 font-sans leading-relaxed mb-6">Revenue, retention, reviews, and loyalty — all in one real-time dashboard. No more spreadsheet wrangling across 6 tools.</p>
          <ul class="space-y-2.5">
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Real-time KPI tracking
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Retention trend charts
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Power household leaderboard
            </li>
            <li class="flex items-center gap-2.5 text-sm text-text-onDark-500">
              <svg class="w-4 h-4 text-violet-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              Churn risk alerts with AI insights
            </li>
          </ul>
        </div>
        <div>
          <FeatureDashboard client:load />
        </div>
      </div>
    </div>
  </div>
</section>