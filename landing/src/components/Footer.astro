---
const productLinks = [
  { label: "Features", href: "#" },
  { label: "Integrations", href: "#" },
  { label: "Pricing", href: "#" },
  { label: "Demo", href: "#" },
  { label: "Changelog", href: "#" },
];

const companyLinks = [
  { label: "About", href: "#" },
  { label: "Blog", href: "#" },
  { label: "Careers", href: "#" },
  { label: "Privacy", href: "#" },
  { label: "Terms", href: "#" },
];

const socialLinks = [
  { label: "Twitter", href: "#" },
  { label: "LinkedIn", href: "#" },
  { label: "YouTube", href: "#" },
];
---

<footer
  class="bg-ink-900"
  itemscope
  itemtype="https://schema.org/Organization"
>
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div
      class="grid gap-12 md:grid-cols-3"
    >
      <div>
        <span
          itemprop="name"
          class="text-xl font-bold text-onDark-100"
        >
          RetainOS
        </span>
        <p class="mt-4 text-sm leading-relaxed text-onDark-500">
          The branded patient app for modern dental practices. Automate recalls,
          boost case acceptance, and own your patient relationships \u2014 not
          rent them.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-onDark-500">
          Product
        </h3>
        <ul class="mt-5 space-y-3">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-onDark-100 transition-colors hover:text-violet-400"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-onDark-500">
          Company
        </h3>
        <ul class="mt-5 space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-onDark-100 transition-colors hover:text-violet-400"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-ink-border">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-6 sm:flex-row lg:px-8"
    >
      <p class="text-xs text-onDark-500">
        &copy; {new Date().getFullYear()} RetainOS, LLC.
        <span itemprop="legalName">RetainOS</span>. All rights reserved.
      </p>

      <div class="flex items-center gap-6">
        <nav class="flex gap-4" aria-label="Social">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs text-onDark-500 transition-colors hover:text-violet-400"
            >
              {link.label}
            </a>
          ))}
        </nav>
        <nav class="flex gap-4" aria-label="Legal">
          <a
            href="#"
            class="text-xs text-onDark-500 transition-colors hover:text-violet-400"
          >
            Privacy Policy
          </a>
          <a
            href="#"
            class="text-xs text-onDark-500 transition-colors hover:text-violet-400"
          >
            Terms of Service
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>
