---
// Sticky mobile CTA — appears after 600px scroll, dismissable
---

<div id="sticky-mobile-cta" class="fixed bottom-0 left-0 right-0 z-40 md:hidden -translate-y-full transition-transform duration-300">
  <div class="bg-ink-900 border-t border-ink-border px-4 py-3 flex items-center gap-2">
    <button onclick="window.dispatchEvent(new Event('open-demo-form'))" class="flex-1 px-4 py-3 rounded-full bg-violet-600 text-white text-sm font-semibold flex items-center justify-center gap-1.5 shadow-md active:scale-95 transition-transform">
      Launch My App
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
    <a href="https://app.retaindental.com" class="px-4 py-3 rounded-full border border-ink-border text-onDark-500 text-sm font-semibold active:scale-95 transition-transform">
      Free Trial
    </a>
    <button id="sticky-mobile-cta-close" type="button" class="p-2 text-onDark-500 hover:text-onDark-100" aria-label="Dismiss">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>

<script>
  (() => {
    const el = document.getElementById('sticky-mobile-cta');
    const close = document.getElementById('sticky-mobile-cta-close');
    if (!el) return;
    if (sessionStorage.getItem('stickyCtaDismissed') === '1') {
      el.classList.add('-translate-y-full');
    }
    const onScroll = () => {
      if (window.scrollY > 600) {
        el.classList.remove('-translate-y-full');
      } else {
        el.classList.add('-translate-y-full');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    if (close) {
      close.addEventListener('click', () => {
        el.classList.add('-translate-y-full');
        sessionStorage.setItem('stickyCtaDismissed', '1');
      });
    }
  })();
</script>
