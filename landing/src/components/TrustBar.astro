---
const clinics = ['Northside Dental', 'Bright Smile Studio', 'Cedar Park Ortho', 'Harbor Dental', 'Lakeview Family Dental', 'Summit Smiles']
---
<section class="border-y border-cream-200 bg-cream-50 py-10">
  <div class="mx-auto max-w-8xl px-5 sm:px-8">
    <p class="text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-400">
      Trusted by growing practices across the US
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {clinics.map((c) => (
        <span class="font-heading text-base font-semibold text-ink-400/80 hover:text-ink-600 transition-colors">{c}</span>
      ))}
    </div>
  </div>
</section>
