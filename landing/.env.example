# ---------------------------------------------------------------------------
# Retain Dental landing (Astro). Copy to `.env.local` for local dev.
# Everything here is PUBLIC_ prefixed, so it is exposed to the browser by design.
# Never put a service role key or any private secret in a PUBLIC_/VITE_ var.
# ---------------------------------------------------------------------------

# Lead delivery for the free-trial onboarding (/start) and forms.
# Leave unset to use the built-in Formspree form, or point it at your own:
#   - Formspree:      https://formspree.io/f/<your-form-id>
#   - Google Sheet:   https://script.google.com/macros/s/<deployment-id>/exec
PUBLIC_LEAD_ENDPOINT=

# Analytics (all optional; each tag only loads when its id is set)
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_GOOGLE_ADS_ID=
