# ============================================================================
# RetainDental - environment template
# Copy to `.env.local` for local dev. NEVER commit real values.
# ============================================================================

# --- App (Vite, public - ends up in the browser bundle) ---------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" switches services/BackendFactory.ts from the mock to Supabase
VITE_USE_REAL_BACKEND=true
# Platform owner identity (used only to recognise the super-admin profile).
# The password is entered manually at /god and is NEVER bundled.
VITE_GOD_EMAIL=owner@retaindental.com

# --- Cloudflare Pages Functions (server-side only, never VITE_ prefixed) -----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Preferred: scoped Cloudflare API Token (Pages:Edit + DNS:Edit)
CF_API_TOKEN=
# Legacy fallback (Global API Key) if you did not create a scoped token
CF_API_KEY=
CF_API_EMAIL=
CF_ZONE_ID=
CF_ACCOUNT_ID=
APP_BASE_DOMAIN=app.retaindental.com

# --- Vercel marketing site (landing/) ---------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
